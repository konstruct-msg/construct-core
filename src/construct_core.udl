namespace construct_core {
    // Device ID functions
    string derive_device_id(bytes identity_public_key);
    string format_federated_id(string device_id, string server_hostname);

    // Intake credentials — what a sealed envelope carries instead of a Privacy Pass
    // token when the recipient has vouched for the sender. The tag is per RECIPIENT and
    // identical for every sender holding the key, which is what keeps it from becoming a
    // pseudonymous sender handle. See construct-docs/decisions/
    // contact-traffic-is-vouched-not-purchased.md.
    bytes generate_intake_key();
    u64 intake_epoch(u64 unix_seconds);
    [Throws=CryptoError]
    bytes intake_tag(bytes intake_key, string recipient_account_id, u64 epoch);

    // `supports_pq_ratchet()` was here: suite 3 is mandatory in every platform build, and the
    // unsigned bundle flag it fed was the downgrade (PQXDH v2 cutover).

    // Wire payload framing is the core's (wire_payload.rs). A platform reads routing fields with
    // this and nothing else; it never packs a payload, and never decrypts one from components —
    // `OrchestratorCore.encrypt_to_wire` / `decrypt_wire_payload` take and give whole payloads.
    // `wire_payload_pack` was here: rebuilding a payload from components is how suite-3 tags and
    // the PN field went missing, and it had no caller left.
    [Throws=CryptoError]
    WirePayload wire_payload_unpack(bytes data);

    /// What a received payload is, for routing: its message number and whether it can open a
    /// receiving session. One parse, in the core, from the bytes as they arrived — a platform
    /// keeps the payload and this, not a copy of the parse (`ChatMessage` carried nine parsed
    /// fields beside the payload until 2026-09-29 and sent three of them back in with it).
    [Throws=CryptoError]
    WireSummary wire_summary(bytes wire_payload);

    // Media blobs — the encrypted file a media message points to (media.rs). Sealed here, in
    // one format for every client, and padded to a Padmé bucket so the server sees a size class
    // rather than the size. `open_media` opens this format and the pre-0.33 one.
    /// A fresh key, the blob to upload, and the blob's SHA-256 for the message.
    /// Throws `EncryptionFailed` when `plaintext` is longer than `media_max_plaintext_len()`.
    [Throws=CryptoError]
    SealedMedia seal_media(bytes plaintext);
    /// The file in `blob`. Throws `InvalidKeyData` for a key that is not 32 bytes,
    /// `DecryptionFailed` when the blob does not open with it, `InvalidCiphertext` when it opens
    /// but is not well formed.
    [Throws=CryptoError]
    bytes open_media(bytes key, bytes blob);
    /// The largest file `seal_media` takes — check before encoding or uploading anything.
    u64 media_max_plaintext_len();

    // Safety Numbers — human-verifiable key fingerprint for two devices
    string? compute_safety_number(string my_device_id, string their_device_id);

    // KNST plaintext frame — the header every message body is framed with before encryption.
    // The core's, since 0.31; vectors: construct-protos/conformance/knst_frame.json.
    /// `payload` split into frames of at most 3770 bytes, each carrying the whole body's length;
    /// an empty body is one frame. Null when it needs more than 256 frames, or `message_id` is not
    /// a UUID.
    sequence<bytes>? knst_encode_chunks(bytes payload, u8 content_type, string message_id);
    /// One frame holding the whole payload — a control carrier, never split. Null when
    /// `message_id` is not a UUID.
    bytes? knst_frame_whole(bytes payload, u8 content_type, string message_id);
    /// The header and payload of a frame; null when `frame` is not one (magic, version, length).
    KnstFrame? knst_parse(bytes frame);

    /// Whether to open a session with a device now.
    ///
    /// Called at the moment a client wants a session and has none it can use. Answering this
    /// locally is what produced 2026-09-04: both sides opened an INITIATOR session thirty-three
    /// seconds apart, each alone when it decided, and the conversation stopped for thirty-two
    /// seconds until one fell back to responder.
    InitiationDecision plan_initiation(InitiationContext context);

    /// Classify a message: can it open a receiving session? One rule, one implementation —
    /// every client asks rather than reimplements. A handshake header (the KEM ciphertext) opens
    /// at any message number.
    ReceivingInitKind receiving_init_kind(ReceivingInitCarrier carrier);

    /// Every device that must receive its own ciphertext of an outgoing message.
    /// The caller owns the account-space facts — whose devices these are, and whether the
    /// recipient is itself — and passes them in; the decision over the sets is made here.
    /// An empty `our_device_id` means "unknown", and then no own-replica copy is planned.
    sequence<DeliveryTarget> plan_send(sequence<string> recipient_device_ids, sequence<string> own_device_ids, string our_device_id, boolean recipient_is_self);

    // Which of a peer's device sessions an incoming message is tried against, in order.
    // Empty `preferred_device_id` means no preference. Attempting is non-destructive: a failed
    // decrypt restores the ratchet snapshot it took before touching anything.
    sequence<string> plan_receiving_decrypt(sequence<string> session_device_ids, string preferred_device_id);
    
    // Proof of Work functions
    PowSolution compute_pow(string challenge, u32 difficulty);
    PowSolution compute_pow_with_progress(
        string challenge,
        u32 difficulty,
        PowProgressCallback? progress_callback
    );
    boolean verify_pow(string challenge, PowSolution solution, u32 required_difficulty);
};

// ============================================================================
// Wire payload framing (canonical binary layout owned by wire_payload.rs)
// ============================================================================

// Mirrors wire_payload::DecodedWirePayload. `pq_ratchet_field` is the opaque
// serialized suite-3 field (empty = none); the core translates it to/from the
// canonical wire encoding so platform SDKs never touch the byte layout.
/// A parsed KNST frame. `message_id` is the dashed lowercase UUID; `payload` is everything after
/// the header — for a control frame (`total_chunks == 1`) the body is its first
/// `plaintext_length` bytes.
/// See `seal_media`.
dictionary SealedMedia {
    bytes key;
    bytes blob;
    bytes sha256;
};

dictionary KnstFrame {
    u8 content_type;
    string message_id;
    u16 chunk_index;
    u16 total_chunks;
    u32 plaintext_length;
    bytes payload;
};

dictionary WirePayload {
    bytes dh_public_key;        // 32-byte X25519 ephemeral public key
    u32 message_number;
    u32 one_time_prekey_id;            // 0 = fallback 3-DH / not a first message
    u32 kyber_otpk_id;                 // the responder's Kyber prekey (SPK ids from 1, one-time from 1 000 000); 0 = none
    u32 previous_chain_length;         // Double Ratchet PN field
    u16 suite_id;                      // ratchet suite (1 classic, 4 PQ ratchet); the PQXDH v2 bit is stripped / set by the core
    bytes? kem_ciphertext;      // ML-KEM-1024 ciphertext on the initiator's first flight
    bytes sealed_box;           // nonce || ciphertext || auth_tag
    u32 pq_message_epoch;              // PQ-ratchet epoch tag (0 otherwise)
    bytes pq_ratchet_field;     // PQ-ratchet sparse field, serialized (empty = none)
    boolean pqxdh_v2 = false;          // the wire carried the PQXDH v2 flag
    bytes? kem_identity = null;               // the initiator's ML-KEM-1024 identity key (first flight)
    bytes? identity_proof_ciphertext = null;  // the responder's answer to it, until the initiator proves itself
    u32 pq_key_index = 0;              // the key's index in the sender's chain of pq_message_epoch
};

// ============================================================================
// Device-Based Authentication
// ============================================================================

dictionary PowChallenge {
    string challenge;
    u32 difficulty;
    i64 expires_at;
};

dictionary PowSolution {
    u64 nonce;
    string hash;
};

callback interface PowProgressCallback {
    void on_progress(u64 current_nonce, u64 attempts, f32 estimated_progress);
};

// ============================================================================
// Registration & Key Bundles
// ============================================================================

dictionary RegistrationBundleFields {
    bytes identity_public;
    bytes signed_prekey_public;
    bytes signature;
    bytes verifying_key;
    u16 suite_id;
};

/// Result of a signed pre-key rotation.
dictionary RotatedSpkBundle {
    u32 key_id;
    bytes public_key;  // raw X25519 public key bytes (32 bytes)
    bytes signature;   // raw Ed25519 signature bytes (64 bytes)
};

// A sender certificate as the platform unsealed it: the fields the server signed and its
// signature, unchecked. The core decides whether it may open a session
// (decisions/first-message-opens-without-the-server).
dictionary SenderCertificate {
    string user_id;
    string domain;
    bytes identity_key;
    string device_id;
    i64 issued_at;
    i64 expires_at;
    bytes signature;
    // Id of the delegated server key and its hybrid Ed25519 ‖ ML-DSA-65 signature
    // (decisions/server-keys-rooted-offline-and-hybrid.md). Empty from a server that does not
    // sign with a delegated key yet.
    bytes server_kid;
    bytes server_signature_hybrid;
};

// What may be said about a sender certificate: the checks a session opens on, as a label.
// `Expired` comes only after the signature and the device have passed.
enum CertificateVerdict {
    "Vouched",
    "NoKey",
    "BadSignature",
    "Expired",
};

// A KT inclusion proof as a bundle carries it (KtInclusionProof in key_service.proto).
dictionary KtInclusionProof {
    u64 leaf_index;
    u64 tree_size;
    bytes root_hash;
    sequence<bytes> proof_hashes;
    bytes tree_head_signature;
};

// The tree head a bundle's proofs are relative to, signed by a delegated server key.
dictionary KtSignedTreeHead {
    u64 tree_size;
    bytes root_hash;
    bytes kid;
    bytes signature;
};

enum KtVerdict {
    "Verified",
    "Unavailable",
    "MalformedProof",
    "InclusionProofInvalid",
    "SignatureInvalid",
};

// The verdicts on a bundle's proofs: the X25519 identity key's, and the hybrid key's when one was
// given.
dictionary KtVerdicts {
    KtVerdict identity;
    KtVerdict? hybrid;
};

// What `open_receiving` did. On success `opened_device` and `opener_message_id` are set and
// `actions` carries the rest (the opener's own decrypt answer, the save, the drain, the notice). On
// failure they are null, `tried_message_ids` lists every carrier proven unopenable,
// `dropped_message_ids` the rest of the queue, `last_error` the last refusal, and `actions` a
// `SendDecryptionError` for each message given up whose writer the server vouches for.
// `awaiting_server_key`: a carrier could not be checked because no server key was set — nothing
// was tried or dropped, and the same open can succeed after `set_trusted_server_keys`.
dictionary ReceivingOpenResult {
    string? opened_device;
    string? opener_message_id;
    sequence<CfeAction> actions;
    sequence<string> tried_message_ids;
    sequence<string> dropped_message_ids;
    string? last_error;
    bytes? kyber_prekeys;
    boolean awaiting_server_key;
};

dictionary SessionInitResult {
    string session_id;
    bytes decrypted_message;  // raw plaintext bytes — may be binary or UTF-8
    bytes storage_key;  // 32-byte random key for the first received message
    // The core's Kyber prekeys after this init burned a one-time key: persist it as the
    // `export_kyber_prekeys()` blob. Null when nothing changed.
    bytes? kyber_prekeys;
};

/// Binary key bundle passed across the FFI boundary — no JSON encoding.
/// Replaces the former bytes JSON payload for init_session / init_receiving_session.
dictionary BinaryKeyBundle {
    bytes identity_public;
    bytes signed_prekey_public;
    bytes signature;
    bytes verifying_key;
    u16 suite_id;
    bytes? one_time_prekey_public;
    u32? one_time_prekey_id;
    u64 spk_uploaded_at;
    u32 spk_rotation_epoch;
    u64 kyber_spk_uploaded_at;
    u32 kyber_spk_rotation_epoch;
    // ── PQXDH v2: everything below comes from the key service as served. PQ is mandatory: a
    // bundle that does not yield a Kyber prekey the core can trust is refused ("PQ_REQUIRED: …").
    // Every Kyber prekey is signed, Ed25519 by `verifying_key` and hybrid by `hybrid_identity_key`,
    // over "KonstruktX3DH-v1" || 0x00 0x11 || created_at (u64 BE) || public key.
    /// Kyber signed prekey (ML-KEM-1024, 1568 bytes), its id and signed creation time.
    bytes? kyber_pre_key_public;
    u32? kyber_pre_key_id = null;
    u64? kyber_pre_key_created_at = null;
    bytes? kyber_pre_key_signature = null;
    bytes? kyber_pre_key_hybrid_signature = null;
    /// Kyber one-time prekey (id from 1 000 000), preferred when present and signed.
    bytes? kyber_one_time_prekey_public;
    u32? kyber_one_time_prekey_id;
    u64? kyber_one_time_prekey_created_at = null;
    bytes? kyber_one_time_prekey_signature = null;
    bytes? kyber_one_time_prekey_hybrid_signature = null;
    /// Hybrid identity key (Ed25519 + ML-DSA-65, 1984 bytes; field 20) and the Ed25519
    /// cross-signature binding it to `verifying_key` (field 21). Pinned per device on first use.
    bytes? hybrid_identity_key = null;
    bytes? hybrid_identity_signature = null;
};

/// How a session's post-quantum layer started.
enum PqHandshake {
    "None",        // no ML-KEM at session start
    "DeferredV1",  // before the PQXDH v2 cutover: first sending chain was X25519-only
    "InitialV2",   // PQXDH v2: ML-KEM-1024 in the initial key, every message covered
};

/// Read-only health snapshot of a Double Ratchet session.
/// Whose Kyber key a session's post-quantum layer came from. Anything a person sees about
/// "PQ" reads this — `is_pq_strengthened` only says a KEM secret was mixed in.
enum PqAuthentication {
    "Unknown",          // recorded before this existed; claims nothing
    "Classic",          // no Kyber contribution
    "Authenticated",    // we encapsulated to a Kyber key whose signature verified
    "Unauthenticated",  // we encapsulated to an unsigned Kyber key: passive-recorder protection only
    "Received",         // we are the responder; the initiator has not yet proved its KEM identity key
    "ReceivedProven",   // we are the responder; the initiator proved the KEM identity key pinned for its device
};

/// Returned by get_session_health(). Does not mutate session state.
dictionary SessionHealthReport {
    u32 messages_sent;
    u32 messages_received;
    u32 skipped_keys_count;
    boolean is_pq_strengthened;
    u64 last_ratchet_at;
    string session_id;
    PqAuthentication pq_authentication;
    PqHandshake pq_handshake;
};

/// A session envelope opened by `OrchestratorCore.open_envelope`
/// (construct-docs decisions/sealed-envelope-keyed-by-the-session.md).
dictionary EnvelopeOpened {
    string contact_id;   // the device whose pair matched: who wrote it
    string session_id;   // pass on as MessageReceived.envelope_session
    u8 kind;             // 1 = ratchet wire payload, 2 = DECRYPTION_ERROR
    bytes body;
    boolean retired;     // its ratchet state is gone here; a ratchet body will not decrypt
};

/// A session's first flight opened by `OrchestratorCore.open_first_flight`
/// (construct-docs decisions/first-flight-sealed-whole.md): handled as before — the
/// certificate names the writer, the wire payload goes to MessageReceived.
dictionary FirstFlightOpened {
    bytes certificate;
    bytes wire_payload;
};

/// How late messages arrive, for this process (PQR-4, construct-docs TODO 64.3). Local
/// diagnostics for the platform's log: never sent anywhere.
dictionary ReorderStats {
    u64 decrypted;               // messages decrypted
    u64 previous_epoch;          // …tagged with the epoch before the decrypting state's current one
    u64 older_epoch;             // …tagged two or more epochs back: opened only by a skipped key
    u32 max_epoch_lag;           // the largest such lag
    u32 max_skip_depth;          // the most messages one message overtook
    u64 evicted_epoch_failures;  // undecryptable, tagged older than every chain held: lost
};

dictionary DecryptedMessageResult {
    bytes plaintext;
    bytes storage_key;  // 32-byte random key — store in MessageKeyStore; use to re-encrypt plaintext at rest
};

dictionary PrivateKeysJson {
    string identity_secret;
    string signing_secret;
    string signed_prekey_secret;
    string prekey_signature;
    string suite_id;
    string? identity_public_check;
    string? verifying_key_check;
    string? signed_prekey_public_check;
};

[Error]
enum CryptoError {
    "InitializationFailed",
    "SessionNotFound",
    "SessionInitializationFailed",
    "EncryptionFailed",
    "DecryptionFailed",
    "InvalidKeyData",
    "InvalidCiphertext",
    "SerializationFailed",
    "MessagePackDeserializationFailed",
    "PeerSpkStale",
};

dictionary OtpkPair {
    u32 key_id;
    bytes public_key;
};

dictionary OtpkRecord {
    u32 key_id;
    bytes private_key;
    bytes public_key;
};

/// One ML-KEM-1024 Kyber prekey to upload (PQXDH v2). Both signatures are over
/// `"KonstruktX3DH-v1" || 0x00 0x11 || created_at (u64 BE) || public_key`; upload `created_at`
/// with the key — the signatures cover it.
dictionary KyberPrekeyUpload {
    u32 key_id;                    // SPKs count from 1, one-time keys from 1_000_000
    bytes public_key;       // 1568 bytes
    u64 created_at;                // unix seconds
    bytes signature;        // Ed25519, identity signing key
    bytes hybrid_signature; // Ed25519 + ML-DSA-65, hybrid identity key (3373 bytes)
};

interface ClassicCryptoCore {
    /// Typed registration bundle fields.
    [Throws=CryptoError]
    RegistrationBundleFields get_registration_bundle_fields();

    [Throws=CryptoError]
    bytes sign_bundle_data(bytes bundle_data_json);

    [Throws=CryptoError]
    bytes export_private_keys();

    [Throws=CryptoError]
    void import_private_keys(bytes data);

    [Throws=CryptoError]
    bytes export_session(string contact_id);

    [Throws=CryptoError]
    string import_session(string contact_id, bytes data);

    sequence<string> get_all_session_contact_ids();

    SessionHealthReport? get_session_health(string contact_id);

    [Throws=CryptoError]
    string init_session(string contact_id, BinaryKeyBundle recipient_bundle);

    // `encrypt_message` / `decrypt_message` (components) were here; see OrchestratorCore.

    boolean remove_session(string contact_id);

    u32 prekeys_available_count();

    [Throws=CryptoError]
    sequence<OtpkPair> generate_one_time_prekeys(u32 count);

    u32 one_time_prekey_count();

    [Throws=CryptoError]
    bytes export_one_time_prekeys();

    [Throws=CryptoError]
    void import_one_time_prekeys(bytes data);

    u32 prune_one_time_prekeys_below(u32 min_keep_id);

    void set_local_user_id(string user_id);

    /// Rotate the signed pre-key. Generates a new X25519 keypair, signs it with
    /// the device Ed25519 signing key, updates internal state, and returns the
    /// new public key + signature for atomic upload to the key server.
    /// The old SPK is kept in memory for a grace period to decrypt in-flight messages.
    [Throws=CryptoError]
    RotatedSpkBundle rotate_signed_prekey();

};

// ============================================================================
// Invite Crypto (Dynamic Contact Invites)
// ============================================================================

dictionary EphemeralKeyPair {
    bytes secret_key;
    bytes public_key;
};

// ============================================================================
// Account Recovery (BIP39 + SLIP-0010 Ed25519)
// ============================================================================

dictionary RecoveryKeypair {
    bytes private_key;
    bytes public_key;
};

// ============================================================================
// Traffic Protection (Cover Traffic & Timing)
// ============================================================================

dictionary CoverTrafficConfig {
    boolean enabled;
    float battery_level_threshold;
    u64 min_interval_ms;
    u64 max_interval_ms;
    u64 message_size;
    boolean coalesce_with_real_messages;
    u64 coalesce_window_ms;
};

dictionary EnergyMetrics {
    u64 dummies_sent;
    u64 coalesced_count;
    u64 battery_skipped;
};

dictionary TimingConfig {
    u64 heartbeat_interval_sec;
    u64 heartbeat_jitter_ms;
    u64 max_send_delay_ms;
    boolean enabled;
    boolean battery_aware;
};

interface TrafficProtectionManager {
    constructor(CoverTrafficConfig config);

    void update_battery_level(float level);
    void record_real_message_sent();
    boolean should_send_dummy();
    bytes generate_dummy();
    EnergyMetrics get_metrics();
    void reset_metrics();
    u64 current_interval_ms();
    boolean is_currently_active();
};

// ── Post-Quantum Cryptography (ML-KEM) ───────────────────────────────────────

/// Result of an ML-KEM-1024 encapsulation (history transfer to a peer's Kyber SPK).
dictionary MLKEMEncapsulation {
    bytes ciphertext;
    bytes shared_secret;
};

// ── Post-Quantum Signatures (ML-DSA-65) ─────────────────────────────────────

/// Generated ML-DSA-65 keypair for post-quantum identity signatures.
dictionary MLDSAKeyPair {
    /// Secret key: 32-byte signing seed (RustCrypto ml-dsa; expanded key re-derived on sign)
    bytes secret_key;
    /// Public key: 1952 bytes
    bytes public_key;
};

/// Hybrid signature keypair (Ed25519 + ML-DSA-65).
/// Used for post-quantum identity key bundles.
dictionary HybridSignatureKeyPair {
    /// Hybrid private key: 2016 bytes
    /// [ed25519_seed (32)] [mldsa65_seed (32)] [mldsa65_pk (1952)]
    bytes private_key;
    /// Hybrid public key: 1984 bytes
    /// [ed25519_pk (32)] [mldsa65_pk (1952)]
    bytes public_key;
};

namespace construct_core {
    [Throws=CryptoError]
    ClassicCryptoCore create_crypto_core();

    [Throws=CryptoError]
    ClassicCryptoCore create_crypto_core_from_keys(bytes keys);

    // ── The key record without a core object ────────────────────────────────
    // What a client needs before it knows its user id, without holding a
    // ClassicCryptoCore: make keys, register them, sign with them, then hand the
    // record to create_orchestrator_core_from_keys. `keys` / the result is the
    // CFE key record (the bytes export_private_keys returns): opaque to the
    // platform, which stores it and never reads a key out of it. Stateless.

    /// Fresh device keys (identity, signing, signed prekey) as a key record.
    [Throws=CryptoError]
    bytes generate_private_keys();

    /// The public registration bundle of a key record.
    [Throws=CryptoError]
    RegistrationBundleFields registration_bundle_fields_from_keys(bytes keys);

    /// Ed25519 signature over bundle_data_json with the key record's signing key.
    [Throws=CryptoError]
    bytes sign_bundle_data_with_keys(bytes keys, bytes bundle_data_json);

    // Invite Crypto Functions
    [Throws=CryptoError]
    EphemeralKeyPair generate_ephemeral_keypair();
    
    [Throws=CryptoError]
    boolean verify_invite_signature(string data, bytes signature, bytes verifying_key);

    // ── Account Recovery (BIP39 + SLIP-0010 Ed25519) ─────────────────────────

    [Throws=CryptoError]
    string generate_mnemonic(u8 word_count);

    boolean validate_mnemonic(string mnemonic);

    [Throws=CryptoError]
    bytes mnemonic_to_seed(string mnemonic);

    [Throws=CryptoError]
    RecoveryKeypair derive_recovery_keypair(bytes seed);

    [Throws=CryptoError]
    bytes sign_recovery_challenge(bytes private_key, string message);

    boolean verify_recovery_signature(bytes public_key, string message, bytes signature);

    // Traffic Protection Functions
    bytes generate_dummy_message(u64 size);
    boolean is_dummy_message(bytes data);

    // Timing Functions
    u64 jittered_interval_ms(u64 base_ms, u64 jitter_ms);
    u64 random_send_delay_ms(u64 max_delay_ms);
    u64 heartbeat_interval_ms(u64 base_interval_sec);
    u64 battery_aware_jitter_ms(u64 base_ms, u64 max_jitter_ms, float battery_level);
    u64 recommended_send_delay_ms(boolean is_high_priority, float battery_level);

    // ── Post-Quantum KEM (ML-KEM-1024) ───────────────────────────────────────
    // The handshake runs ML-KEM inside the core; nothing on the platform calls it for sessions.
    // History transfer encapsulates to a peer's Kyber SPK with this, and the receiving side
    // decapsulates with `OrchestratorCore.kyber_prekey_decapsulate` (the seed never leaves the core).

    /// Encapsulate to an ML-KEM-1024 public key (1568 bytes).
    [Throws=CryptoError]
    MLKEMEncapsulation mlkem1024_encapsulate(bytes public_key);

    // ── Post-Quantum Signatures (ML-DSA-65 + Hybrid) ────────────────────────

    /// Generate an ML-DSA-65 keypair (post-quantum signature scheme, NIST FIPS 204).
    [Throws=CryptoError]
    MLDSAKeyPair mldsa65_keygen();

    /// Sign a message with an ML-DSA-65 secret key. Returns a detached signature (3309 bytes).
    [Throws=CryptoError]
    bytes mldsa65_sign(bytes secret_key, bytes message);

    /// Verify an ML-DSA-65 detached signature. Returns true if valid.
    [Throws=CryptoError]
    boolean mldsa65_verify(bytes public_key, bytes message, bytes signature);

    /// Generate a hybrid signature keypair (Ed25519 + ML-DSA-65).
    /// Both signatures must verify for the hybrid signature to be valid.
    [Throws=CryptoError]
    HybridSignatureKeyPair hybrid_signature_keygen();

    /// Sign a message with a hybrid private key (Ed25519 + ML-DSA-65).
    /// Returns a hybrid signature: [ed25519_sig (64)] [mldsa65_sig (3309)] = 3373 bytes.
    [Throws=CryptoError]
    bytes hybrid_sign(bytes private_key, bytes message);

    /// Verify a hybrid signature. Both Ed25519 and ML-DSA-65 signatures must be valid.
    [Throws=CryptoError]
    boolean hybrid_verify(bytes public_key, bytes message, bytes signature);

    /// Derive the hybrid public key from a hybrid private key.
    [Throws=CryptoError]
    bytes hybrid_public_key_from_private(bytes private_key);

    // ── Orchestration (Phase 0) ───────────────────────────────────────────────

    /// Create an OrchestratorCore from CFE binary or legacy JSON key bytes.
    /// Accepts both formats — Rust handles detection and migration internally.
    [Throws=CryptoError]
    OrchestratorCore create_orchestrator_core_from_keys(bytes keys_data, string my_user_id);

    /// Verify that a PlatformBridge implementation correctly round-trips a
    /// save → load through the platform secure store.
    /// Returns true if the loaded bytes equal the saved bytes.
    [Throws=CryptoError]
    boolean test_platform_bridge_roundtrip(PlatformBridge bridge, string key, bytes data);
};

// ============================================================================
// Orchestration — PlatformBridge (Phase 0)
// ============================================================================

/// Callback interface implemented by Swift / Kotlin.
///
/// Rust orchestration logic is I/O-free: it calls through this bridge to
/// request platform operations (Keychain, Core Data, os_log / Logcat).
/// Each method is synchronous from Rust's perspective.
callback interface PlatformBridge {
    /// Persist `data` under `key` in the platform secure store (Keychain / Keystore).
    void save_to_secure_store(string key, bytes data);

    /// Retrieve data previously saved under `key`. Returns null if absent.
    bytes? load_from_secure_store(string key);

    /// Append / upsert a JSON record in the platform data store (Core Data / Room).
    /// `table` is a logical table name; `json` is the record payload.
    void persist_record(string table, string json);

    /// Query the platform data store. Returns a JSON-encoded result or null.
    string? query_record(string table, string query_json);

    /// Emit a log entry through the platform logging system (os_log / Logcat).
    /// `level` ∈ {"debug", "info", "warn", "error"}.
    void log_event(string level, string tag, string message);
};

// ============================================================================
// Orchestration — Module Interfaces (Phases 1a, 1b, 2)
// ============================================================================

// ── AckCheckResult ────────────────────────────────────────────────────────────

/// Result of checking whether a message has already been processed.
/// Whose device an outgoing copy is for. A copy to our own device is the pair (me, me), which the
/// relay already knows; a copy to a peer's device is not, and must be sealed to that device's key.
enum DeliveryAudience {
    "Recipient",
    "OwnReplica",
};

dictionary DeliveryTarget {
    string device_id;
    DeliveryAudience audience;
};

/// What a message is, for the purpose of opening a receiving session.
enum ReceivingInitKind {
    /// Carries the initiator's handshake header: this message can open a session.
    "Handshake",
    /// Carries none: it decrypts on a state already held or not at all.
    "MidRatchet",
};

/// See `wire_summary`.
dictionary WireSummary {
    u32 message_number;
    ReceivingInitKind init_kind;
};

/// The wire-visible shape of a queued message, for `receiving_init_kind`.
/// No ciphertext: deciding whether a message *could* open a session must not require its body.
dictionary ReceivingInitCarrier {
    u32 message_number;
    u32 one_time_prekey_id;
    u32 kem_ciphertext_bytes;
    u32 pq_message_epoch;
};

/// Whether to open a session with a device right now. See orchestration::initiation_plan.
enum InitiationDecision {
    /// Open a fresh session as INITIATOR now.
    "Initiate",
    /// One of ours is already in flight — join it. A second init spends another one-time prekey
    /// for a state that will not be used.
    "JoinInFlight",
    /// The peer's handshake is in hand: open from it rather than build a second state.
    "YieldToPeer",
    /// Nothing to send and no init in the air. Opening spends a prekey on a session that carries
    /// nothing and doubles the chance of colliding with the peer's next one.
    "Wait",
};

/// What the caller knows at the moment it wants a session. Every field is something only the
/// caller can see — the network, the outbox, the UI; the decision over them is made in the core.
dictionary InitiationContext {
    /// Ours and theirs in the space the session is addressed by.
    string my_device_id;
    string peer_device_id;
    /// We are opening a session with this device right now (bundle fetch and init).
    boolean our_init_in_flight;
    /// We hold the peer's init — received, not yet completed.
    boolean peer_init_in_flight;
    /// Something is waiting to be sent to this device. Not "a warm session would be nice".
    boolean have_outbound_work;
};

enum AckCheckResult {
    /// Definitely a duplicate — found in the in-memory cache.
    "InCache",
    /// Not in cache; caller must query the persistent store before deciding.
    "NeedDbCheck",
    /// Confirmed not a duplicate (after DB check returned nothing).
    "NotProcessed",
};

/// Thread-safe ACK deduplication store.
///
/// Replaces Swift `PersistentACKStore`. The in-memory `HashSet` lives here;
/// CoreData / Room persistence is handled by the orchestrator CFE state.
interface RustAckStore {
    constructor();

    /// Returns `InCache` if the hot-path cache contains `message_id`, else `NeedDbCheck`.
    AckCheckResult is_processed(string message_id);

    /// Mark `message_id` as processed in the in-memory cache.
    void mark_processed(string message_id);

    /// Evict expired entries from the in-memory cache.
    void prune_expired();

    /// Current in-memory cache size (diagnostic).
    u64 cache_len();
};

// `HealingAttemptResult` and `interface RustHealingQueue` stood here until 2026-09-23, and the
// orchestrator's own healing queue until 2026-09-27: a session record keeps its previous states
// and any message with the handshake header opens, so there is nothing to heal
// (decisions/sessions-renew-by-sending.md).

// ── OrchestratorCore ──────────────────────────────────────────────────────────

// ── Typed event bus ──────────────────────────────────────────────────────────

/// Typed replacement for `IncomingEvent` JSON strings.
/// Platform creates one of these variants and passes to `handle_event()`.
[Enum]
interface CfeIncomingEvent {
    /// `envelope_session`: the session whose envelope the message came in (`open_envelope`),
    /// set instead of `sender_certificate`.
    MessageReceived(string message_id, string from, bytes data, u8 content_type, SenderCertificate? sender_certificate, string? envelope_session);
    OutgoingMessage(string contact_id, string message_id, bytes plaintext, u8 content_type);
    OutgoingCallSignal(string contact_id, string message_id, bytes proto_bytes);
    SessionInitCompleted(string contact_id, bytes session_data);
    AckReceived(string message_id);
    /// The answer to `CfeAction::OpenSession`: the bundle of that one device. The core reopens
    /// from it and answers with the save, the messages that waited, or `OPEN_SESSION_REFUSED`.
    SessionBundleFetched(string contact_id, BinaryKeyBundle bundle);
    /// The answer to `CfeAction::OpenSession` when no bundle could be fetched. The held session
    /// stays; the core stops waiting for the open now instead of at its time-out.
    SessionBundleUnavailable(string contact_id);
    NetworkReconnected();
    AppLaunched();
    TimerFired(string timer_id);
    /// Platform ACK DB lookup result — response to `CheckAckInDb` action.
    AckDbResult(string message_id, boolean is_processed);
    /// A heartbeat message was received from the peer.
    HeartbeatReceived(string contact_id, string message_id, bytes data);
    /// A DECRYPTION_ERROR (content type 28) arrived from `contact_id` — the device its sender
    /// certificate names; `payload` is the envelope's sealed box. Answered with `SessionRetired` +
    /// `ResendMessage`, `ResendMessage` alone, or nothing when the error is stale.
    /// `opened`: `payload` came out of a session envelope and is the error itself.
    DecryptionErrorReceived(string contact_id, bytes payload, boolean opened);
};

/// Which durable slot a `SaveToSecureStore` payload belongs in.
///
/// The core names what the bytes are; the platform names where they go. This replaced a formatted
/// string key (`"session_<id>"`, `"archive_<id>"`, …) that the platform parsed back apart — a
/// naming rule for a store the core does not own, written six times across two repositories.
[Enum]
interface CfeSecureStoreSlot {
    /// Double Ratchet state for one contact. Empty payload means delete.
    Session(string contact_id);
    /// Orchestrator coordination state.
    OrchestratorState();
};

/// Typed replacement for `Action` JSON strings.
/// Platform receives these from `handle_event()` and executes each one.
[Enum]
interface CfeAction {
    DecryptMessage(string contact_id, bytes ciphertext);
    EncryptMessage(string contact_id, bytes plaintext);
    ArchiveSession(string contact_id);
    MessageDecrypted(string contact_id, string message_id, bytes plaintext);
    /// Open a new session with `contact_id` — a device — as INITIATOR over the one held: fetch
    /// that device's bundle and answer with `SessionBundleFetched` (or `SessionBundleUnavailable`).
    /// Do not call `reopen_session` for it: the event's answer carries the save and the drained
    /// queue that the call cannot. Nothing is sent — the handshake header rides on the next
    /// message. Raised by the PQXDH v2 upgrade sweep.
    OpenSession(string contact_id);
    /// Message queued inside the core behind an in-flight session init. Nothing lost.
    MessageQueuedPendingInit(string contact_id, u32 queued_count);
    /// Write `data` into `slot`; empty `data` is a delete sentinel where the slot says so.
    SaveToSecureStore(CfeSecureStoreSlot slot, bytes data);
    PersistAck(string message_id, u64 timestamp);
    PruneAckStore(u64 cutoff_ts);
    MarkMessageDelivered(string message_id);
    /// A message already handled (ACK cache, platform DB, or its ratchet key already used).
    /// Terminal: record it as processed and advance the stream cursor past it.
    DuplicateDropped(string message_id);
    /// A message whose payload does not parse (garbage, or a retired suite): it can never open.
    /// Terminal: record it as processed and advance the stream cursor past it. Nothing is sent.
    MalformedDropped(string message_id);
    // A message waits for a session with `contact_id` and can open one: call
    // `open_receiving(contact_id)`. Nothing is fetched — the key comes from the sender certificate.
    OpenReceiving(string contact_id);
    SendEncryptedMessage(string to, bytes payload, string message_id, u8 content_type);
    SendReceipt(string message_id, string status);
    /// We could not read `message_id` from `contact_id`: send `payload` to that device as a
    /// DECRYPTION_ERROR (content type 28) envelope, sealed-sender, and acknowledge the message.
    /// The core built and sealed `payload`; one per unread message.
    /// `enveloped`: `payload` is a session envelope — send it as the sealed inner's envelope with
    /// no certificate; otherwise it is the X25519 box, sent as before.
    SendDecryptionError(string contact_id, string message_id, bytes payload, boolean enveloped);
    /// The peer could not read our current state with `contact_id`; it is retired and the next
    /// send opens a new one — without a one-time prekey when `without_one_time_prekey`.
    SessionRetired(string contact_id, boolean without_one_time_prekey);
    /// The peer could not read `message_id`: send it again to `contact_id` as a new message.
    ResendMessage(string contact_id, string message_id);
    NotifyNewMessage(string chat_id, string preview);
    NotifySessionCreated(string contact_id);
    NotifyError(string code, string message);
    ScheduleTimer(string timer_id, u64 delay_ms);
    CancelTimer(string timer_id);
    CallSignalDecrypted(string contact_id, string message_id, bytes proto_bytes);
    /// A silent control frame other than a call signal (13, 14, 25, 26, 27, 29), named by byte 5
    /// of its KNST frame; `body` is without the header. Never a chat message: handle by
    /// `content_type` and record the message processed.
    ControlFrameDecrypted(string contact_id, string message_id, u8 content_type, bytes body);
    /// Platform must query its persistent ACK store for `message_id` and reply with `AckDbResult`.
    CheckAckInDb(string message_id);
};

/// Top-level orchestration facade.
///
/// Swift / Kotlin call `handle_event_json` with a JSON-encoded `IncomingEvent`
/// and receive a JSON-encoded `Vec<Action>`. All I/O is delegated back to the
/// platform via these `Action` values.
///
/// Replaces: CryptoManager + MessageRouter + SessionCoordinator + SessionHealingService
///           + PersistentACKStore + PQCKeyManager + SessionInitializationService.
interface OrchestratorCore {
    /// Typed event handler — accepts a typed `CfeIncomingEvent` and returns typed `CfeAction` list.
    [Throws=CryptoError]
    sequence<CfeAction> handle_event(CfeIncomingEvent event);

    /// Suite ID for the active session with `contact_id`.
    /// Returns 0 if no session exists.
    u16 get_session_suite_id(string contact_id);

    /// Typed registration bundle — replaces `export_registration_bundle_json()` parsing.
    [Throws=CryptoError]
    RegistrationBundleFields get_registration_bundle_fields();

    /// Check if a message ID is in the in-memory ACK cache.
    AckCheckResult ack_is_processed(string message_id);

    /// Mark a message as processed in the ACK cache.
    void ack_mark_processed(string message_id);


    // ── Session crypto (delegation from ClassicCryptoCore) ───────────────────

    [Throws=CryptoError]
    bytes export_private_keys();

    [Throws=CryptoError]
    bytes sign_bundle_data(bytes bundle_data_json);

    // Hybrid PQ identity signature key (Ed25519+ML-DSA-65). Centralized in core.
    [Throws=CryptoError]
    bytes ensure_hybrid_signature_key();

    bytes? hybrid_signature_public_key();

    [Throws=CryptoError]
    bytes sign_hybrid(bytes message);

    // ── Operations with this device's own keys ───────────────────────────────
    // The platform asks for the operation, never for the key. Each replaced a platform reading
    // the secret out (`get_signing_key_bytes`, `get_identity_key_bytes`, a Keychain copy) and
    // doing the operation in CryptoKit / Tink or through a free function taking the secret.

    /// Ed25519 over `message` with this device's signing key (device auth, invites). The same
    /// signature `sign_invite_data` / CryptoKit made from the exported key: Ed25519 is deterministic.
    [Throws=CryptoError]
    bytes sign_with_device_key(bytes message);

    /// Open a box sealed to this device's X25519 identity key (`sealed_seal_sender_cert`,
    /// `seal_to_device_key`): a sender certificate, a sibling's device metadata. A box sealed to
    /// another key fails with DecryptionFailed, which is how a caller finds its own copy.
    [Throws=CryptoError]
    bytes open_sealed_to_device(bytes sealed_box);

    /// `device_copy_tag` with our identity key.
    [Throws=CryptoError]
    string device_copy_tag(string base_message_id, string target_device_id, bytes peer_identity_public);

    /// `device_copy_tag_matches` with our identity key and our device id, which the core derives
    /// from that key rather than taking it from the caller.
    boolean device_copy_tag_matches(string tag, string base_message_id, bytes peer_identity_public);

    /// The history-file (CTHF) channel key on the receiving side: HKDF-SHA256 over
    /// X25519(identity, sender_eph) ‖ the ML-KEM decapsulation of `kem_ciphertext` under Kyber
    /// prekey `kem_key_id`, salt "construct_history_file_v1", info `snapshot_id`. The channel key,
    /// not the X25519 output: that would open every box sealed to this device.
    [Throws=CryptoError]
    bytes history_file_channel_key(bytes sender_eph_pub, u32 kem_key_id, bytes kem_ciphertext, bytes snapshot_id);

    /// This device's social-recovery bundle (device keys, derived device id, `created_at`) sealed
    /// under the 32-byte `vault_key` — the `sr_seal_recovery_bundle` format, packed in the core so
    /// only the ciphertext leaves it.
    [Throws=CryptoError]
    bytes seal_own_recovery_bundle(bytes vault_key, i64 created_at);

    /// A fresh MLS store signing with this device's Ed25519 key.
    [Throws=MlsError]
    MlsStore new_mls_store();

    /// An MLS store restored from `MlsStore.export_cfe()`, signing with this device's key.
    [Throws=MlsError]
    MlsStore import_mls_store(bytes data);

    // ── History transfer ─────────────────────────────────────────────────────
    // The whole protocol: CTH1 records, the sealed chunk stream, CTT1 v2 and CTHF. Sans-I/O —
    // the platform moves bytes, the core decides. `user_id` is this account's 16 raw UUID bytes.
    // See construct-docs/decisions/history-transfer-protocol-in-the-core.md.

    /// Offer history over the local network to the device `peer` names. Write
    /// `first_frame()`, read `HISTORY_REPLY_LEN` bytes into `accept_reply`, then stream. A skip
    /// is the same signed opening and nothing after it. `pinned_receiver_identity` is the new
    /// device's identity from a Flow B QR, when this side scanned one.
    [Throws=HistoryError]
    HistorySender history_offer_nearby(bytes user_id, HistoryPeerKeys peer, boolean skip, bytes? pinned_receiver_identity);

    /// Offer history as a CTHF file for `peer`: write `first_frame()`, then stream.
    [Throws=HistoryError]
    HistorySender history_offer_file(bytes user_id, HistoryPeerKeys peer);

    /// Receive history, over the local network or from a file.
    [Self=ByArc]
    HistoryReceiver history_receive(bytes user_id, boolean from_file);

    // High-level helpers to avoid duplicating message construction in every client.
    // These match the domain-separated formats used for SPK/Kyber-SPK hybrid signatures
    // and the hybrid<->classic identity binding cross-signature.

    bytes build_x3dh_sign_message(u8 suite_id, bytes public_key);

    bytes build_hybrid_identity_bind_message(bytes hybrid_public_key);

    [Throws=CryptoError]
    bytes sign_hybrid_prekey(u8 suite_id, bytes public_key);

    // For migration: import a hybrid sig private key that was previously stored outside the core CFE.
    [Throws=CryptoError]
    void import_hybrid_signature_private_key(bytes priv_bytes);

    [Throws=CryptoError]
    bytes export_session(string contact_id);

    [Throws=CryptoError]
    string import_session(string contact_id, bytes data);

    sequence<string> get_all_session_contact_ids();

    boolean has_session(string contact_id);

    SessionHealthReport? get_session_health(string contact_id);

    /// Seal a wire payload just encrypted for `contact_id` as a session envelope; null when it
    /// must go with a certificate (first flight, or a session made before the envelope).
    bytes? seal_envelope(string contact_id, bytes wire_payload);

    /// Who wrote `envelope`, by its tag, and its opened body; null when no pair matches.
    EnvelopeOpened? open_envelope(bytes envelope);

    /// Seal a first flight — a wire payload written on a session the peer has not answered yet —
    /// with the sender certificate, to `recipient_identity` (the X25519 key the session was opened
    /// to; it must derive to `contact_id`). Goes in `SealedInner.first_flight`. Null when the
    /// payload carries no handshake — not a first flight; it goes with a certificate. Throws for a
    /// first flight that cannot be sealed: never send that one any other way.
    [Throws=CryptoError]
    bytes? seal_first_flight(string contact_id, bytes recipient_identity, bytes wire_payload, bytes certificate);

    /// Open a `SealedInner.first_flight` sealed to this device. Throws when it does not open — a
    /// Kyber prekey no longer held (`FIRST_FLIGHT_KEY_UNAVAILABLE`), or not ours.
    [Throws=CryptoError]
    FirstFlightOpened open_first_flight(bytes sealed);

    /// How late messages have arrived since the process started (PQR-4).
    ReorderStats reorder_stats();

    [Throws=CryptoError]
    string init_session(string contact_id, BinaryKeyBundle recipient_bundle);

    // Degraded INITIATOR init: identical to init_session but skips ONLY the SPK
    // age-staleness reject (PeerSpkStale). Signature verification, the X3DH agreement,
    // and the kyber-epoch requirement are all still enforced. Used to reach a peer who
    // has been offline too long to rotate their SPK (see stale-peer-reachability decision).
    // The caller is responsible for flagging the resulting session as "at-risk".
    [Throws=CryptoError]
    string init_session_allowing_stale(string contact_id, BinaryKeyBundle recipient_bundle);

    // An open the platform decides on, over a session held (a manual reset, a diagnostic
    // re-init): builds the new session first and replaces the held one only if that succeeded,
    // keeping it as a previous state. NOT the answer to CfeAction.OpenSession — that is the
    // SessionBundleFetched event, whose answer carries the save and the drained queue. A refusal (PQ_REQUIRED while the peer has no Kyber-1024 keys yet) leaves the held
    // session exactly as it was. Do not remove the session yourself before calling it.
    [Throws=CryptoError]
    string reopen_session(string contact_id, BinaryKeyBundle recipient_bundle);

    // The server's certificate-signing keys: the well-known key and any pins. Nothing opens a
    // receiving session until they are set, because a certificate is what it opens from.
    void set_trusted_server_keys(sequence<bytes> keys);

    // Delegations of the server's hybrid keys, from `/.well-known` `server_trust.delegations` or
    // the platform's cache of them. Each is kept only if a root this build pins signed it; returns
    // how many were. Like the keys above, handed over at every launch.
    u32 admit_server_delegations(sequence<bytes> delegations);

    // The label for a sender certificate — signature, device and age, judged as an open would.
    CertificateVerdict certificate_verdict(SenderCertificate certificate);

    // Judge a bundle's KT proofs. `hybrid_identity_key` and `hybrid_proof` go together.
    KtVerdicts verify_kt_proofs(string device_id, bytes identity_key, KtInclusionProof identity_proof, bytes? hybrid_identity_key, KtInclusionProof? hybrid_proof, KtSignedTreeHead? tree_head);

    // RESPONDER init of one message outside the queue — a sibling's SENDER_SYNC. The session is
    // opened with the key `sender_certificate` names, under the device it names, after the core
    // has checked it; no bundle is fetched.
    [Throws=CryptoError]
    SessionInitResult init_receiving_session_from_wire_payload(SenderCertificate sender_certificate, bytes wire_payload);

    // Open a receiving session from the messages the core holds under `device`. Each opens with
    // the key its own sender certificate names, once the core has checked that certificate; one
    // attempt per carrier, no bundle. See decisions/first-message-opens-without-the-server.
    ReceivingOpenResult open_receiving(string device);

    // Whether any of `devices` has a session-opening message queued within the last 20 s — the
    // peer opening a session with us right now. Pass every device of the account known so far,
    // including ones named only by a sender certificate.
    boolean peer_handshake_held(sequence<string> devices);

    // How many messages wait for a session with `contact_id`.
    u32 pending_message_count(string contact_id);

    /// Encrypt for a device and return the whole wire payload. Sent as it is: a payload rebuilt
    /// from components dropped fields (decisions/responder-authenticates-initiator-by-kem.md).
    [Throws=CryptoError]
    bytes encrypt_to_wire(string contact_id, bytes plaintext);

    /// Decrypt a whole wire payload on the states held with a device.
    [Throws=CryptoError]
    DecryptedMessageResult decrypt_wire_payload(string contact_id, bytes wire_payload);

    boolean remove_session(string contact_id);

    /// Drop every piece of local orchestration state this core holds about `contact_id`:
    /// the ratchet and its previous states, the prekey counter, the PQ contribution, the init lock,
    /// the queue, the prewarm mark and the active-chat mark.
    ///
    /// `remove_session` removes the ratchet **and nothing else**, so all of the above outlive it
    /// and steer the next add for the same device — a contact the platform has already forgotten.
    /// None of them is reachable from outside this crate, which is why "the platform deleted this
    /// contact" had no expression here until now.
    ///
    /// Silent on the wire on purpose: a local deletion boundary, not a protocol reset.
    void forget_contact_state(string contact_id);

    /// The person reset the session with `contact_id`: the current state is retired locally and
    /// the next send opens a new one. Nothing is sent. Execute the returned save.
    sequence<CfeAction> retire_session(string contact_id);

    u32 prekeys_available_count();

    [Throws=CryptoError]
    sequence<OtpkPair> generate_one_time_prekeys(u32 count);

    u32 one_time_prekey_count();

    [Throws=CryptoError]
    bytes export_one_time_prekeys();

    [Throws=CryptoError]
    void import_one_time_prekeys(bytes data);

    u32 prune_one_time_prekeys_below(u32 min_keep_id);

    // ── Kyber prekeys (ML-KEM-1024, PQXDH v2) ────────────────────────────────
    // The core generates, signs and holds them; the seeds never leave it. After every call
    // that changes them, persist `export_kyber_prekeys()` (as with `export_one_time_prekeys`).

    [Throws=CryptoError]
    sequence<KyberPrekeyUpload> generate_kyber_one_time_prekeys(u32 count);

    u32 kyber_one_time_prekey_count();

    /// After a replace-all upload of Kyber one-time keys; returns how many were removed.
    u32 prune_kyber_one_time_prekeys_below(u32 min_keep_id);

    /// Start a Kyber SPK rotation (with the classic SPK): the key to upload. Calling it again
    /// before commit/rollback returns the same key, so a retried upload uploads the same key.
    [Throws=CryptoError]
    KyberPrekeyUpload begin_kyber_spk_rotation();

    /// The server confirmed the upload. Returns false if nothing was pending.
    boolean commit_kyber_spk_rotation();

    /// The upload failed.
    void rollback_kyber_spk_rotation();

    /// The current Kyber SPK's upload record again, or null before the first commit.
    [Throws=CryptoError]
    KyberPrekeyUpload? current_kyber_spk_upload();

    /// Decapsulate with our Kyber prekey `key_id` (0 = current SPK). For history transfer; the
    /// handshake decapsulates inside the core.
    [Throws=CryptoError]
    bytes kyber_prekey_decapsulate(u32 key_id, bytes ciphertext);

    [Throws=CryptoError]
    bytes export_kyber_prekeys();

    [Throws=CryptoError]
    void import_kyber_prekeys(bytes data);

    void set_local_user_id(string user_id);

    [Throws=CryptoError]
    RotatedSpkBundle rotate_signed_prekey();

    /// Export the full orchestrator coordination state (init locks, prekey tracker, pins) as a
    /// CFE binary blob.
    /// Persist under CfeSecureStoreSlot::OrchestratorState.
    [Throws=CryptoError]
    bytes export_orchestrator_state();

    /// Restore the full orchestrator coordination state from a CFE blob.
    /// Call at app start before processing any messages.
    [Throws=CryptoError]
    void import_orchestrator_state(bytes data);

};

// ── History transfer ─────────────────────────────────────────────────────────

/// The other device's keys from our own account's directory entry (`GetPreKeyBundles`).
dictionary HistoryPeerKeys {
    bytes identity_public;
    bytes hybrid_public;
    bytes kyber_prekey_public;
    u32 kyber_prekey_id;
};

/// The keys the directory holds for the device a frame names. Checked against the frame's own,
/// and the signature is verified with these.
dictionary HistoryKnownKeys {
    bytes identity_public;
    bytes hybrid_public;
};

/// What the link QR pinned for the other device.
[Enum]
interface HistoryPin {
    /// Flow A: SHA256(identity ‖ hybrid) of the offering device (`history_qr_fingerprint`).
    Fingerprint(bytes fingerprint);
    /// Flow B, or a file outside the link session: the directory is the only pin.
    BundleOnly();
    /// Nothing pins the other device: refused.
    Absent();
};

/// One transcript record to send: its type (0x01 manifest … 0x07 call) and protobuf bytes.
dictionary HistoryRecordOut {
    u8 record_type;
    bytes proto;
};

/// What the receiver hands back, in stream order. A transcript record is its protobuf bytes,
/// already checked against the protocol rules: decode it straight into the store. Media arrives
/// in pieces — append each to the file.
[Enum]
interface HistoryEvent {
    Record(u8 record_type, bytes proto);
    Skipped(u8 record_type);
    MediaStart(string media_id, string mime_type, u64 byte_len);
    MediaBytes(bytes data);
    MediaEnd();
    End();
};

[Enum]
interface HistoryStatus {
    /// Read `need()` more bytes and feed them.
    NeedMore();
    /// Fetch the keys of `sender_device_id` from our own account's directory, then `accept`.
    AwaitKeys(string sender_device_id);
    /// A verified skip: nothing follows.
    Skipped();
    /// Ended with End and EOF. Commit.
    Done();
};

dictionary HistoryStep {
    sequence<HistoryEvent> events;
    HistoryStatus status;
};

/// Why a transfer was refused. Each case's message is the spec's name for it (`record_order`,
/// `qr_pin_mismatch`, …) — log that, map the case to what a person reads.
[Error]
enum HistoryError {
    "Malformed",
    "Truncated",
    "UnknownVersion",
    "UserMismatch",
    "RecordOrder",
    "EnvelopeManifestMismatch",
    "V1RefusedForHistory",
    "IdentityMismatch",
    "KemKeyIdMismatch",
    "QrPinMismatch",
    "QrPinAbsent",
    "NoHybridKey",
    "SignatureInvalid",
    "ChunkOpenFailed",
    "LocalKeysUnavailable",
};

/// The offering device's end. Every call returns bytes to write verbatim: frames, sealed
/// chunks, the EOF — the platform never frames.
interface HistorySender {
    bytes first_frame();
    /// The snapshot id the manifest must carry.
    bytes snapshot_id();
    [Throws=HistoryError]
    void accept_reply(bytes reply);
    /// A batch of transcript records; returns every chunk they completed.
    [Throws=HistoryError]
    bytes push_records(sequence<HistoryRecordOut> records);
    [Throws=HistoryError]
    bytes begin_media(string media_id, string mime_type, u64 byte_len);
    /// The next piece of the blob, in any size; exactly `byte_len` in all.
    [Throws=HistoryError]
    bytes push_media(bytes piece);
    /// End record, last chunk, EOF.
    [Throws=HistoryError]
    bytes finish();
};

/// The new device's end. Read exactly `need()` bytes, `feed` them, act on the status.
interface HistoryReceiver {
    u32 need();
    [Throws=HistoryError]
    HistoryStep feed(bytes data);
    /// After `AwaitKeys`: the directory's keys for that device and the QR pin. Returns the reply
    /// to write back (nearby), or nothing (file, or a verified skip).
    [Throws=HistoryError]
    bytes? accept(HistoryKnownKeys known, HistoryPin pin);
    /// The socket closed or the file ended: `Truncated` unless the stream finished.
    [Throws=HistoryError]
    void end_of_input();
};

namespace construct_core {
    /// Bytes the receiver's reply takes on the local network.
    u32 history_reply_len();
    /// The largest media file a snapshot carries. An encoder leaves a file of this size or more
    /// out (and counts it) rather than fail the stream: the core refuses the record.
    u64 history_max_blob_bytes();
    string history_discovery_tag(string user_id_dashed, string device_id_hex);
    string history_discovery_instance_name(string tag);
    bytes history_qr_fingerprint(bytes identity_public, bytes hybrid_public);
};

// ── ConstructPrivacyPass ──────────────────────────────────────────────────────

// ── SLIP-39 Social Recovery ───────────────────────────────────────────────────


namespace construct_core {
    /// Blind a 32-byte nonce for OPRF token issuance.
    /// Returns packed 64 bytes: blinded_point[0..32] || blind_factor[32..64].
    /// blinded_point is sent to server; blind_factor is kept secret until finalize().
    [Throws=CryptoError]
    bytes pp_blind_token(bytes nonce);

    /// Finalize a blind token after server evaluation.
    /// evaluated_bytes  — 32-byte Ristretto point returned by server (Z = k * blinded)
    /// blind_factor     — the second 32 bytes from pp_blind_token output
    /// nonce            — original 32-byte nonce passed to pp_blind_token
    /// Returns 32-byte token to store in the wallet.
    [Throws=CryptoError]
    bytes pp_finalize_token(
        bytes evaluated_bytes,
        bytes blind_factor_bytes,
        bytes nonce
    );

    /// Verify the evaluated point is a valid Ristretto255 curve point.
    /// server_pubkey_bytes is reserved for future DLEQ batch proof verification.
    /// Returns false if evaluated_bytes cannot be decompressed.
    boolean pp_verify_client(
        bytes evaluated_bytes,
        bytes nonce,
        bytes server_pubkey_bytes
    );

    /// Verify a batched DLEQ proof (IssueTokensResponse.dleq_proof) against the
    /// client-pinned issuer public key K. Returns true iff the same k links
    /// K = k*G and every evaluated[i] = k*blinded[i] — closes malicious-issuer
    /// key-tagging (Phase C). blinded/evaluated are the batch of 32-byte points
    /// (blinded as sent to IssueTokens, evaluated as returned); proof is 64 bytes;
    /// issuer_public is the pinned 32-byte K. False on any malformed input.
    boolean pp_verify_dleq(
        sequence<bytes> blinded,
        sequence<bytes> evaluated,
        bytes proof,
        bytes issuer_public
    );

    /// Seal a finalized 32-byte token to the server's X25519 token-encryption
    /// key (token_encryption_key from /.well-known/construct-server) so relay
    /// operators cannot read spent tokens. Returns
    /// ephemeral_pub(32) || nonce(12) || ciphertext || tag(16).
    [Throws=CryptoError]
    bytes pp_seal_token_bytes(
        bytes token,
        bytes server_encryption_key
    );

    // ── ConstructSEALED (sealed sender, stealth-sealed-sender-v2 Phase 5) ────

    /// Seal serialized SenderCertificate bytes to the recipient's X25519
    /// identity public key (32 bytes). Returns the sealed box:
    /// ephemeral_pub(32) || nonce(12) || ciphertext || tag(16).
    /// Bit-compatible with the iOS CryptoKit implementation.
    [Throws=CryptoError]
    bytes sealed_seal_sender_cert(
        bytes cert_bytes,
        bytes recipient_identity_key
    );

    // ── Device metadata (sealed device directory) ────────────────────────────

    /// Seal a device's own metadata to one of its account's devices.
    ///
    /// Same box as `sealed_seal_sender_cert` and the same implementation — two names because
    /// there are two purposes, and a name describing one is wrong on the other.
    ///
    /// The account has no shared key: every device holds its own X25519 identity pair, and
    /// linking establishes nothing between them. So metadata is sealed once per sibling and
    /// the copies stored together — a copy per device, units of them, and in exchange a
    /// revoked device stops being sealed to on the next re-seal instead of keeping the
    /// ability to read until a key is rotated.
    [Throws=CryptoError]
    bytes seal_to_device_key(
        bytes plaintext,
        bytes device_identity_public
    );

    /// Verify the server Ed25519 signature over a SenderCertificate's fields
    /// (variant-0 payload: user_id || domain || identity_key || device_id ||
    /// BE64(issued_at) || BE64(expires_at) — no separators).
    /// server_verifying_key is the 32-byte bundle verification key from
    /// /.well-known/construct-server. Returns false on any malformed input.
    boolean sealed_verify_sender_cert(
        string user_id,
        string domain,
        bytes identity_key,
        string device_id,
        i64 issued_at,
        i64 expires_at,
        bytes signature,
        bytes server_verifying_key
    );

    // ── Per-device copy tag ───────────────────────────────────────────────────
    //
    // Delivery is per account: the same envelope reaches every one of the
    // recipient's per-device streams. When one message produces one ciphertext
    // per target device, each device must recognise which copy is its own — and
    // the relay must not be able to. See crypto::device_copy_tag.
    //
    //   secret = HKDF-SHA256(X25519(our priv, peer pub),
    //                        salt = "ConstructSSTAG-v1", info = "")
    //   tag    = HMAC-SHA256(secret, base_message_id || 0x00 || target_device_id)
    //            [0..8], lowercase hex — 16 characters.
    //
    // Vectors: construct-protos/conformance/knst_device_copy_tag.json.

    // `device_copy_tag` / `device_copy_tag_matches` taking our identity private key were here;
    // they are `OrchestratorCore` methods since 2026-09-29, and the core derives our device id.

    // ── SLIP-39 Social Recovery ───────────────────────────────────────────────

    /// Generate a 32-byte random vault key.
    [Throws=CryptoError]
    bytes sr_generate_vault_key();

    /// Split vault_key into share_count shares, requiring threshold to reconstruct.
    /// threshold must be <= share_count, both must be 2-10.
    /// Returns one 28-word mnemonic string per share.
    [Throws=CryptoError]
    sequence<string> sr_create_recovery_shares(bytes vault_key, u8 threshold, u8 share_count);

    /// Reconstruct vault_key from at least threshold share mnemonics.
    [Throws=CryptoError]
    bytes sr_reconstruct_vault_key(sequence<string> mnemonics);

    // `sr_seal_recovery_bundle` / `sr_open_recovery_bundle` took and returned the device keys;
    // sealing is `OrchestratorCore.seal_own_recovery_bundle` since 2026-09-29. A restore returns
    // when there is a call that turns a bundle into a key record.
};

// ============================================================================
// MLS Group Chat (RFC 9420) — Messaging Layer Security
// ============================================================================

/// Result of adding a member to an MLS group.
/// `commit` is broadcast to current members (SubmitCommit); `welcome` is
/// delivered to the new member (InviteToGroup).
dictionary MemberAddition {
    bytes commit;
    bytes welcome;
    u32 member_count;
};

/// Errors that can occur during MLS group operations.
[Error]
enum MlsError {
    "CryptoError",
    "EpochMismatch",
    "NotAMember",
    "SerializationError",
    "WelcomeError",
    "CommitError",
    "EncryptionError",
};


/// Device-level MLS store (RFC 9420): ONE long-lived OpenMLS storage holding
/// all group states plus key-package private material. A Welcome can only be
/// decrypted by the store that generated the KeyPackage it addresses, so key
/// package generation, joining and all group operations share this object.
///
/// Persistence contract: after every mutating call, persist `export_cfe()`
/// in the platform secure store. In particular, persist BEFORE uploading a
/// generated key package — otherwise an inviter's Welcome will reference
/// private keys the device no longer holds.
interface MlsStore {
    // No constructor: `OrchestratorCore.new_mls_store` / `import_mls_store` bind the device's
    // signing key, which never crosses the FFI (it was two constructor arguments until 2026-09-29).

    /// Generate a KeyPackage for publishing (PublishKeyPackage). Writes its
    /// private material into this store — persist before uploading.
    [Throws=MlsError]
    bytes generate_key_package();

    /// Create a new group with this device as the sole member.
    /// Returns the group id — the handle for every other group call.
    [Throws=MlsError]
    bytes create_group();

    /// Join a group from a Welcome message addressed to a KeyPackage
    /// generated by this store. Returns the joined group's id.
    [Throws=MlsError]
    bytes join_from_welcome(bytes welcome);

    /// Encrypt an application message to the group.
    [Throws=MlsError]
    bytes encrypt(bytes group_id, bytes plaintext);

    /// Decrypt an application message from another member.
    [Throws=MlsError]
    bytes decrypt(bytes group_id, bytes ciphertext);

    /// Add a member by their published KeyPackage. The commit is merged
    /// locally — call only when about to SubmitCommit.
    [Throws=MlsError]
    MemberAddition add_member(bytes group_id, bytes key_package);

    /// Remove a member by leaf index. Commit is merged locally.
    [Throws=MlsError]
    bytes remove_member(bytes group_id, u32 leaf_index);

    /// Propose leaving. Broadcast the returned message; another member's
    /// commit actually removes us.
    [Throws=MlsError]
    bytes leave_group(bytes group_id);

    /// Process and merge a commit produced by another member.
    [Throws=MlsError]
    void process_commit(bytes group_id, bytes commit);

    /// Current number of members in the group.
    [Throws=MlsError]
    u32 member_count(bytes group_id);

    /// Current MLS epoch. Increments on every commit.
    [Throws=MlsError]
    u64 epoch(bytes group_id);

    /// Snapshot the entire MLS storage as a CFE blob (msg_type 0x44).
    [Throws=MlsError]
    bytes export_cfe();
};

// ============================================================================
// Local store — construct-store, the one store every client keeps
// construct-docs/decisions/local-store-in-the-core.md
// ============================================================================
// SQLCipher-encrypted whole; the key is 32 random bytes the platform keeps in its key store.
// Times are Unix milliseconds. Writes are announced to the observer after they commit.

[Error]
enum LocalStoreError {
    "WrongKey",
    "KeyLength",
    "SchemaTooNew",
    "Closed",
    "Storage",
};

enum LocalStoreTable {
    "Contacts",
    "Chats",
    "Messages",
    "Reactions",
    "Calls",
    "PeerDevices",
};

enum LocalInsert {
    "Inserted",
    "AlreadyPresent",
};

dictionary LocalStoreChange {
    LocalStoreTable table;
    sequence<string> ids;
};

/// Told after every committed write, on the writing thread, never under the store's lock.
callback interface LocalStoreObserver {
    void on_change(LocalStoreChange change);
};

dictionary LocalContact {
    string id;
    string username;
    string display_name;
    string? local_alias;
    bytes? avatar;
    string? public_key;
    bytes? known_identity_key;
    bytes? account_address;
    boolean is_contact;
    boolean is_blocked;
    boolean is_sharing_with_me;
    boolean am_i_sharing_with;
    i64? shared_with_me_at;
    i64? added_at;
    i16 kt_status;
    boolean hybrid_capable;
    i16 security_notice;
};

dictionary LocalChat {
    string id;
    string peer_id;
    string? last_message_text;
    i64? last_message_time;
    string? session_id;
    boolean is_pinned;
    boolean is_muted;
    i32 unread_count;
};

dictionary LocalMessage {
    string id;
    string chat_id;
    string from_user_id;
    string to_user_id;
    boolean is_sent_by_me;
    i64 timestamp;
    string order_key;
    bytes body;
    i16 content_type;
    i16 delivery_status;
    i16 retry_count;
    i16 suite_id;
    boolean is_edited;
    i64? edited_at;
    string? reply_to_message_id;
    string? reply_to_content;
    string? transcript_text;
    string? transcript_language;
    i64? transcript_generated_at;
};

dictionary LocalReaction {
    string target_message_id;
    string reactor_user_id;
    string emoji;
    i64 timestamp_ms;
    i64? received_at;
};

dictionary LocalCall {
    string id;
    string peer_user_id;
    string peer_name;
    i16 direction;
    i16 status;
    i64? started_at;
    i64? ended_at;
    i32 duration_seconds;
};

dictionary LocalPeerDevice {
    string device_id;
    string account_id;
    bytes identity_key;
    i64 first_seen_at;
};

dictionary LocalSearchHit {
    string message_id;
    string chat_id;
    i64 timestamp;
};

interface LocalStore {
    /// Open — creating if absent — the store at `path` under `key`. A key that does not open it
    /// is `WrongKey`, never a fresh empty store.
    [Throws=LocalStoreError]
    constructor(string path, bytes key);

    /// A store in memory only, under the same encryption path. Tests and previews.
    [Throws=LocalStoreError, Name=in_memory]
    constructor(bytes key);

    void set_observer(LocalStoreObserver? observer);

    /// Close and delete every file of the store. Every later call is `Closed`. The platform
    /// deletes the key.
    [Throws=LocalStoreError]
    void wipe();

    [Throws=LocalStoreError]
    void upsert_contact(LocalContact contact);
    [Throws=LocalStoreError]
    LocalContact? contact(string id);
    /// People marked as contacts, by the name shown for them.
    [Throws=LocalStoreError]
    sequence<LocalContact> contacts();
    /// Takes the contact's chats and their messages with it.
    [Throws=LocalStoreError]
    void delete_contact(string id);

    [Throws=LocalStoreError]
    void upsert_chat(LocalChat chat);
    [Throws=LocalStoreError]
    LocalChat? chat(string id);
    /// Pinned first, then most recent, chats with no message last.
    [Throws=LocalStoreError]
    sequence<LocalChat> chats();
    [Throws=LocalStoreError]
    void delete_chat(string id);

    /// `search_text` is what the message says, for the full-text index; null for media/control.
    [Throws=LocalStoreError]
    LocalInsert insert_message(LocalMessage message, string? search_text);
    [Throws=LocalStoreError]
    boolean edit_message(string id, bytes body, string? search_text, i64 edited_at);
    [Throws=LocalStoreError]
    boolean set_delivery_status(string id, i16 status);
    [Throws=LocalStoreError]
    LocalMessage? message(string id);
    /// Up to `limit` messages just before (`before_order_key`, `before_id`) — both null for the
    /// newest page — oldest first.
    [Throws=LocalStoreError]
    sequence<LocalMessage> messages_before(string chat_id, string? before_order_key, string? before_id, u32 limit);
    [Throws=LocalStoreError]
    void delete_message(string id);
    /// Messages whose text contains `query` (one phrase, three characters at least), newest first.
    [Throws=LocalStoreError]
    sequence<LocalSearchHit> search(string query, u32 limit);

    [Throws=LocalStoreError]
    void upsert_reaction(LocalReaction reaction);
    [Throws=LocalStoreError]
    sequence<LocalReaction> reactions(string target_message_id);
    [Throws=LocalStoreError]
    void delete_reaction(string target_message_id, string reactor_user_id);

    [Throws=LocalStoreError]
    void upsert_call(LocalCall call);
    [Throws=LocalStoreError]
    sequence<LocalCall> calls(u32 limit);

    /// An id already known keeps its first account.
    [Throws=LocalStoreError]
    LocalInsert record_peer_device(LocalPeerDevice device);
    /// Oldest first; devices first seen in the same millisecond by id.
    [Throws=LocalStoreError]
    sequence<LocalPeerDevice> peer_devices(string account_id);
    [Throws=LocalStoreError]
    LocalPeerDevice? peer_device(string device_id);
    [Throws=LocalStoreError]
    sequence<LocalPeerDevice> all_peer_devices();
    /// Forget devices the server no longer lists; an empty list forgets nothing. Returns the removed.
    [Throws=LocalStoreError]
    sequence<string> retain_peer_devices(string account_id, sequence<string> active);

    /// The server's id of a sealed copy we sent → our message id; lowercase, kept 30 days.
    [Throws=LocalStoreError]
    void record_server_message_id(string server_id, string local_id, i64 recorded_at);
    [Throws=LocalStoreError]
    string? local_message_id(string server_id);
    [Throws=LocalStoreError]
    u64 forget_server_message_ids_before(i64 cutoff);

    [Throws=LocalStoreError]
    void put(string key, bytes value);
    [Throws=LocalStoreError]
    bytes? get(string key);
    [Throws=LocalStoreError]
    void remove(string key);
};
