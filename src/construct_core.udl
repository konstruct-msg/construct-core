namespace construct_core {
    // Device ID functions
    string derive_device_id(sequence<u8> identity_public_key);
    string format_federated_id(string device_id, string server_hostname);

    // Intake credentials — what a sealed envelope carries instead of a Privacy Pass
    // token when the recipient has vouched for the sender. The tag is per RECIPIENT and
    // identical for every sender holding the key, which is what keeps it from becoming a
    // pseudonymous sender handle. See construct-docs/decisions/
    // contact-traffic-is-vouched-not-purchased.md.
    sequence<u8> generate_intake_key();
    u64 intake_epoch(u64 unix_seconds);
    [Throws=CryptoError]
    sequence<u8> intake_tag(sequence<u8> intake_key, string recipient_account_id, u64 epoch);

    // `supports_pq_ratchet()` was here: suite 3 is mandatory in every platform build, and the
    // unsigned bundle flag it fed was the downgrade (PQXDH v2 cutover).

    // Wire payload framing — the SINGLE source of truth for the encrypted_payload
    // byte layout (see wire_payload.rs). Platform SDKs (iOS/Android) MUST call
    // these instead of re-implementing the format, so suite_id / pq_message_epoch /
    // pq_ratchet_field can never be silently dropped on the wire again.
    [Throws=CryptoError]
    sequence<u8> wire_payload_pack(WirePayload payload);
    [Throws=CryptoError]
    WirePayload wire_payload_unpack(sequence<u8> data);

    // Safety Numbers — human-verifiable key fingerprint for two devices
    string? compute_safety_number(string my_device_id, string their_device_id);

    /// Which side opens the session when both try at once: "Initiator" or "Responder".
    ///
    /// Higher id wins, by plain byte comparison — no normalisation, no parsing. Both peers
    /// compute it over the same pair, so a disagreement is a permanent deadlock rather than a
    /// retryable error. Pass the ids the session is addressed by; anything else ranks a
    /// different pair.
    string tie_break_role(string my_id, string peer_id);

    /// Whether to open a session with a device now, and as which side.
    ///
    /// Called at the moment a client wants a session and has none it can use. Answering this
    /// locally is what produced 2026-09-04: both sides opened an INITIATOR session thirty-three
    /// seconds apart, each alone when it decided, and the conversation stopped for thirty-two
    /// seconds until one fell back to responder.
    InitiationDecision plan_initiation(InitiationContext context);

    /// Classify a queued message: can it open a receiving session?
    /// One rule, one implementation — every client asks rather than reimplements. A
    /// `message_number == 0` with an advanced PQ epoch is shaped like an opener and is not one,
    /// which is why this is a named function and not an inline check.
    ReceivingInitKind receiving_init_kind(ReceivingInitCarrier carrier);

    /// Every device that must receive its own ciphertext of an outgoing message.
    /// The caller owns the account-space facts — whose devices these are, and whether the
    /// recipient is itself — and passes them in; the decision over the sets is made here.
    /// An empty `our_device_id` means "unknown", and then no own-replica copy is planned.
    sequence<DeliveryTarget> plan_send(sequence<string> recipient_device_ids, sequence<string> own_device_ids, string our_device_id, boolean recipient_is_self);

    // Which of a peer's device sessions an incoming message is tried against, in order.
    // Empty `preferred_device_id` means no preference. Attempting is non-destructive: a failed
    // decrypt restores the ratchet snapshot it took before touching anything.
    sequence<string> plan_receiving_decrypt(sequence<string> session_device_ids, string preferred_device_id);
    
    // Proof of Work functions
    PowSolution compute_pow(string challenge, u32 difficulty);
    PowSolution compute_pow_with_progress(
        string challenge,
        u32 difficulty,
        PowProgressCallback? progress_callback
    );
    boolean verify_pow(string challenge, PowSolution solution, u32 required_difficulty);
};

// ============================================================================
// Wire payload framing (canonical binary layout owned by wire_payload.rs)
// ============================================================================

// Mirrors wire_payload::DecodedWirePayload. `pq_ratchet_field` is the opaque
// serialized suite-3 field (empty = none); the core translates it to/from the
// canonical wire encoding so platform SDKs never touch the byte layout.
dictionary WirePayload {
    sequence<u8> dh_public_key;        // 32-byte X25519 ephemeral public key
    u32 message_number;
    u32 one_time_prekey_id;            // 0 = fallback 3-DH / not a first message
    u32 kyber_otpk_id;                 // the responder's Kyber prekey (SPK ids from 1, one-time from 1 000 000); 0 = none
    u32 previous_chain_length;         // Double Ratchet PN field
    u16 suite_id;                      // ratchet suite (1/3); the PQXDH v2 bit is stripped / set by the core
    sequence<u8>? kem_ciphertext;      // ML-KEM-1024 ciphertext on the initiator's first flight
    sequence<u8> sealed_box;           // nonce || ciphertext || auth_tag
    u32 pq_message_epoch;              // suite-3 PQ epoch tag (0 otherwise)
    sequence<u8> pq_ratchet_field;     // suite-3 sparse PQ field, serialized (empty = none)
    boolean pqxdh_v2 = false;          // unpack: the wire carried the PQXDH v2 flag. pack: ignored (set from kem_ciphertext)
};

// ============================================================================
// Device-Based Authentication
// ============================================================================

dictionary PowChallenge {
    string challenge;
    u32 difficulty;
    i64 expires_at;
};

dictionary PowSolution {
    u64 nonce;
    string hash;
};

callback interface PowProgressCallback {
    void on_progress(u64 current_nonce, u64 attempts, f32 estimated_progress);
};

// ============================================================================
// Registration & Key Bundles
// ============================================================================

dictionary RegistrationBundleFields {
    sequence<u8> identity_public;
    sequence<u8> signed_prekey_public;
    sequence<u8> signature;
    sequence<u8> verifying_key;
    u16 suite_id;
};

/// Result of a signed pre-key rotation.
dictionary RotatedSpkBundle {
    u32 key_id;
    sequence<u8> public_key;  // raw X25519 public key bytes (32 bytes)
    sequence<u8> signature;   // raw Ed25519 signature bytes (64 bytes)
};

dictionary EncryptedMessageComponents {
    sequence<u8> ephemeral_public_key;
    u32 message_number;
    sequence<u8> content;
    u32 one_time_prekey_id;
    sequence<u8> storage_key;  // 32-byte random key — store in MessageKeyStore; use to re-encrypt plaintext at rest
    u16 suite_id;              // negotiated DR suite (e.g. 3 = PQ_RATCHET); transmit so the receiver rebuilds the exact AEAD AD (task #12)
    u32 pq_message_epoch;      // suite-3 PQ epoch tag (0 otherwise)
    sequence<u8> pq_ratchet_field;  // suite-3 sparse PQ-ratchet field, serialized (empty = none)
    // The PQXDH v2 handshake header — on every message of the initiator's first flight, until the
    // peer answers; empty / 0 otherwise. Pack it as WirePayload.kem_ciphertext / kyber_otpk_id.
    sequence<u8> kem_ciphertext;
    u32 kyber_prekey_id;
};

dictionary SessionInitResult {
    string session_id;
    sequence<u8> decrypted_message;  // raw plaintext bytes — may be binary or UTF-8
    sequence<u8> storage_key;  // 32-byte random key for the first received message
    // The core's Kyber prekeys after this init burned a one-time key: persist it as the
    // `export_kyber_prekeys()` blob. Null when nothing changed.
    sequence<u8>? kyber_prekeys;
};

/// Binary key bundle passed across the FFI boundary — no JSON encoding.
/// Replaces the former sequence<u8> JSON payload for init_session / init_receiving_session.
dictionary BinaryKeyBundle {
    sequence<u8> identity_public;
    sequence<u8> signed_prekey_public;
    sequence<u8> signature;
    sequence<u8> verifying_key;
    u16 suite_id;
    sequence<u8>? one_time_prekey_public;
    u32? one_time_prekey_id;
    u64 spk_uploaded_at;
    u32 spk_rotation_epoch;
    u64 kyber_spk_uploaded_at;
    u32 kyber_spk_rotation_epoch;
    // ── PQXDH v2: everything below comes from the key service as served. PQ is mandatory: a
    // bundle that does not yield a Kyber prekey the core can trust is refused ("PQ_REQUIRED: …").
    // Every Kyber prekey is signed, Ed25519 by `verifying_key` and hybrid by `hybrid_identity_key`,
    // over "KonstruktX3DH-v1" || 0x00 0x11 || created_at (u64 BE) || public key.
    /// Kyber signed prekey (ML-KEM-1024, 1568 bytes), its id and signed creation time.
    sequence<u8>? kyber_pre_key_public;
    u32? kyber_pre_key_id = null;
    u64? kyber_pre_key_created_at = null;
    sequence<u8>? kyber_pre_key_signature = null;
    sequence<u8>? kyber_pre_key_hybrid_signature = null;
    /// Kyber one-time prekey (id from 1 000 000), preferred when present and signed.
    sequence<u8>? kyber_one_time_prekey_public;
    u32? kyber_one_time_prekey_id;
    u64? kyber_one_time_prekey_created_at = null;
    sequence<u8>? kyber_one_time_prekey_signature = null;
    sequence<u8>? kyber_one_time_prekey_hybrid_signature = null;
    /// Hybrid identity key (Ed25519 + ML-DSA-65, 1984 bytes; field 20) and the Ed25519
    /// cross-signature binding it to `verifying_key` (field 21). Pinned per device on first use.
    sequence<u8>? hybrid_identity_key = null;
    sequence<u8>? hybrid_identity_signature = null;
};

/// Binary first-message bundle for init_receiving_session — no JSON encoding.
dictionary BinaryFirstMessage {
    sequence<u8> ephemeral_public_key;
    u32 message_number;
    sequence<u8> content;
    u32 one_time_prekey_id;
    u16 suite_id;              // negotiated DR suite the initiator encrypted with (task #12)
    u32 pq_message_epoch;      // suite-3 PQ epoch tag (0 otherwise)
    sequence<u8> pq_ratchet_field;  // suite-3 sparse PQ-ratchet field, serialized (empty = none)
    // The PQXDH v2 handshake, as `wire_payload_unpack` returned it. Required: a first message
    // without it is refused ("PQXDH_REQUIRED"). `init_receiving_session_from_wire_payload` takes
    // the raw payload and needs none of this copying.
    boolean pqxdh_v2;
    u32 kyber_prekey_id;       // WirePayload.kyber_otpk_id
    sequence<u8> kem_ciphertext;
};

/// How a session's post-quantum layer started.
enum PqHandshake {
    "None",        // no ML-KEM at session start
    "DeferredV1",  // before the PQXDH v2 cutover: first sending chain was X25519-only
    "InitialV2",   // PQXDH v2: ML-KEM-1024 in the initial key, every message covered
};

/// Read-only health snapshot of a Double Ratchet session.
/// Whose Kyber key a session's post-quantum layer came from. Anything a person sees about
/// "PQ" reads this — `is_pq_strengthened` only says a KEM secret was mixed in.
enum PqAuthentication {
    "Unknown",          // recorded before this existed; claims nothing
    "Classic",          // no Kyber contribution
    "Authenticated",    // we encapsulated to a Kyber key whose signature verified
    "Unauthenticated",  // we encapsulated to an unsigned Kyber key: passive-recorder protection only
    "Received",         // we are the responder; the peer encapsulated to our own key
};

/// Returned by get_session_health(). Does not mutate session state.
dictionary SessionHealthReport {
    u32 messages_sent;
    u32 messages_received;
    u32 skipped_keys_count;
    boolean is_pq_strengthened;
    u64 last_ratchet_at;
    string session_id;
    PqAuthentication pq_authentication;
    PqHandshake pq_handshake;
};

dictionary DecryptedMessageResult {
    sequence<u8> plaintext;
    sequence<u8> storage_key;  // 32-byte random key — store in MessageKeyStore; use to re-encrypt plaintext at rest
};

/// Input slot for decrypt_offline_batch.
dictionary OfflineBatchMessage {
    string id;                          // server message ID (for dedup correlation)
    string contact_id;                  // DR session key (userId or userId:deviceId)
    sequence<u8> ephemeral_public_key;  // 32 bytes
    u32 message_number;
    sequence<u8> content;               // raw ciphertext (already unpadded by Swift caller)
    u16 suite_id;                       // negotiated DR suite (task #12); 1/CLASSIC for non-PQ_RATCHET
    u32 pq_message_epoch;               // suite-3 PQ epoch tag (0 otherwise)
    sequence<u8> pq_ratchet_field;      // suite-3 sparse PQ-ratchet field, serialized (empty = none)
};

/// Per-message result from decrypt_offline_batch.
/// Exactly one of plaintext / error is populated.
dictionary OfflineBatchResult {
    string id;                      // mirrors OfflineBatchMessage.id
    sequence<u8>? plaintext;        // Some(_) on success
    string? error;                  // Some(_) on failure; session is NOT archived
    sequence<u8> storage_key;       // 32-byte key (empty when error is Some)
};

dictionary PrivateKeysJson {
    string identity_secret;
    string signing_secret;
    string signed_prekey_secret;
    string prekey_signature;
    string suite_id;
    string? identity_public_check;
    string? verifying_key_check;
    string? signed_prekey_public_check;
};

[Error]
enum CryptoError {
    "InitializationFailed",
    "SessionNotFound",
    "SessionInitializationFailed",
    "EncryptionFailed",
    "DecryptionFailed",
    "InvalidKeyData",
    "InvalidCiphertext",
    "SerializationFailed",
    "MessagePackDeserializationFailed",
    "PeerSpkStale",
};

dictionary OtpkPair {
    u32 key_id;
    sequence<u8> public_key;
};

dictionary OtpkRecord {
    u32 key_id;
    sequence<u8> private_key;
    sequence<u8> public_key;
};

/// One ML-KEM-1024 Kyber prekey to upload (PQXDH v2). Both signatures are over
/// `"KonstruktX3DH-v1" || 0x00 0x11 || created_at (u64 BE) || public_key`; upload `created_at`
/// with the key — the signatures cover it.
dictionary KyberPrekeyUpload {
    u32 key_id;                    // SPKs count from 1, one-time keys from 1_000_000
    sequence<u8> public_key;       // 1568 bytes
    u64 created_at;                // unix seconds
    sequence<u8> signature;        // Ed25519, identity signing key
    sequence<u8> hybrid_signature; // Ed25519 + ML-DSA-65, hybrid identity key (3373 bytes)
};

interface ClassicCryptoCore {
    /// Typed registration bundle fields.
    [Throws=CryptoError]
    RegistrationBundleFields get_registration_bundle_fields();

    /// Raw Ed25519 signing secret key bytes (64 bytes).
    [Throws=CryptoError]
    bytes get_signing_key_bytes();

    /// Raw identity secret key bytes (32 bytes, X25519).
    [Throws=CryptoError]
    bytes get_identity_key_bytes();

    [Throws=CryptoError]
    sequence<u8> sign_bundle_data(sequence<u8> bundle_data_json);

    [Throws=CryptoError]
    sequence<u8> export_private_keys();

    [Throws=CryptoError]
    void import_private_keys(sequence<u8> data);

    [Throws=CryptoError]
    sequence<u8> export_session(string contact_id);

    [Throws=CryptoError]
    string import_session(string contact_id, sequence<u8> data);

    sequence<string> get_all_session_contact_ids();

    SessionHealthReport? get_session_health(string contact_id);

    [Throws=CryptoError]
    string init_session(string contact_id, BinaryKeyBundle recipient_bundle);

    [Throws=CryptoError]
    SessionInitResult init_receiving_session(string contact_id, BinaryKeyBundle recipient_bundle, BinaryFirstMessage first_message);

    [Throws=CryptoError]
    EncryptedMessageComponents encrypt_message(string session_id, string plaintext);

    [Throws=CryptoError]
    DecryptedMessageResult decrypt_message(string session_id, sequence<u8> ephemeral_public_key, u32 message_number, sequence<u8> content, u16 suite_id, u32 pq_message_epoch, sequence<u8> pq_ratchet_field);

    boolean remove_session(string contact_id);

    u32 prekeys_available_count();

    [Throws=CryptoError]
    sequence<OtpkPair> generate_one_time_prekeys(u32 count);

    u32 one_time_prekey_count();

    [Throws=CryptoError]
    sequence<u8> export_one_time_prekeys();

    [Throws=CryptoError]
    void import_one_time_prekeys(sequence<u8> data);

    u32 prune_one_time_prekeys_below(u32 min_keep_id);

    void set_local_user_id(string user_id);

    /// Rotate the signed pre-key. Generates a new X25519 keypair, signs it with
    /// the device Ed25519 signing key, updates internal state, and returns the
    /// new public key + signature for atomic upload to the key server.
    /// The old SPK is kept in memory for a grace period to decrypt in-flight messages.
    [Throws=CryptoError]
    RotatedSpkBundle rotate_signed_prekey();

};

// ============================================================================
// Invite Crypto (Dynamic Contact Invites)
// ============================================================================

dictionary EphemeralKeyPair {
    sequence<u8> secret_key;
    sequence<u8> public_key;
};

dictionary InviteSignature {
    sequence<u8> signature;
};

// ============================================================================
// Account Recovery (BIP39 + SLIP-0010 Ed25519)
// ============================================================================

dictionary RecoveryKeypair {
    sequence<u8> private_key;
    sequence<u8> public_key;
};

// ============================================================================
// Traffic Protection (Cover Traffic & Timing)
// ============================================================================

dictionary CoverTrafficConfig {
    boolean enabled;
    float battery_level_threshold;
    u64 min_interval_ms;
    u64 max_interval_ms;
    u64 message_size;
    boolean coalesce_with_real_messages;
    u64 coalesce_window_ms;
};

dictionary EnergyMetrics {
    u64 dummies_sent;
    u64 coalesced_count;
    u64 battery_skipped;
};

dictionary TimingConfig {
    u64 heartbeat_interval_sec;
    u64 heartbeat_jitter_ms;
    u64 max_send_delay_ms;
    boolean enabled;
    boolean battery_aware;
};

interface TrafficProtectionManager {
    constructor(CoverTrafficConfig config);

    void update_battery_level(float level);
    void record_real_message_sent();
    boolean should_send_dummy();
    sequence<u8> generate_dummy();
    EnergyMetrics get_metrics();
    void reset_metrics();
    u64 current_interval_ms();
    boolean is_currently_active();
};

// ── Post-Quantum Cryptography (ML-KEM) ───────────────────────────────────────

/// Result of an ML-KEM-1024 encapsulation (history transfer to a peer's Kyber SPK).
dictionary MLKEMEncapsulation {
    sequence<u8> ciphertext;
    sequence<u8> shared_secret;
};

// ── Post-Quantum Signatures (ML-DSA-65) ─────────────────────────────────────

/// Generated ML-DSA-65 keypair for post-quantum identity signatures.
dictionary MLDSAKeyPair {
    /// Secret key: 32-byte signing seed (RustCrypto ml-dsa; expanded key re-derived on sign)
    sequence<u8> secret_key;
    /// Public key: 1952 bytes
    sequence<u8> public_key;
};

/// Hybrid signature keypair (Ed25519 + ML-DSA-65).
/// Used for post-quantum identity key bundles.
dictionary HybridSignatureKeyPair {
    /// Hybrid private key: 2016 bytes
    /// [ed25519_seed (32)] [mldsa65_seed (32)] [mldsa65_pk (1952)]
    sequence<u8> private_key;
    /// Hybrid public key: 1984 bytes
    /// [ed25519_pk (32)] [mldsa65_pk (1952)]
    sequence<u8> public_key;
};

namespace construct_core {
    [Throws=CryptoError]
    ClassicCryptoCore create_crypto_core();

    [Throws=CryptoError]
    ClassicCryptoCore create_crypto_core_from_keys(sequence<u8> keys);

    // ── The key record without a core object ────────────────────────────────
    // What a client needs before it knows its user id, without holding a
    // ClassicCryptoCore: make keys, register them, sign with them, then hand the
    // record to create_orchestrator_core_from_keys. `keys` / the result is the
    // CFE key record (the bytes export_private_keys returns). Types mirror the
    // methods each one replaces (export_private_keys, get_signing_key_bytes, …),
    // so values pass between them unconverted. Stateless.

    /// Fresh device keys (identity, signing, signed prekey) as a key record.
    [Throws=CryptoError]
    sequence<u8> generate_private_keys();

    /// The public registration bundle of a key record.
    [Throws=CryptoError]
    RegistrationBundleFields registration_bundle_fields_from_keys(sequence<u8> keys);

    /// The Ed25519 signing secret of a key record.
    [Throws=CryptoError]
    bytes signing_key_from_keys(sequence<u8> keys);

    /// The X25519 identity secret of a key record.
    [Throws=CryptoError]
    bytes identity_key_from_keys(sequence<u8> keys);

    /// Ed25519 signature over bundle_data_json with the key record's signing key.
    [Throws=CryptoError]
    sequence<u8> sign_bundle_data_with_keys(sequence<u8> keys, sequence<u8> bundle_data_json);

    // Invite Crypto Functions
    [Throws=CryptoError]
    EphemeralKeyPair generate_ephemeral_keypair();
    
    [Throws=CryptoError]
    InviteSignature sign_invite_data(string data, sequence<u8> identity_secret_key);
    
    [Throws=CryptoError]
    boolean verify_invite_signature(string data, sequence<u8> signature, sequence<u8> verifying_key);
    
    [Throws=CryptoError]
    sequence<u8> derive_verifying_key_from_secret(sequence<u8> identity_secret_key);

    // ── Account Recovery (BIP39 + SLIP-0010 Ed25519) ─────────────────────────

    [Throws=CryptoError]
    string generate_mnemonic(u8 word_count);

    boolean validate_mnemonic(string mnemonic);

    [Throws=CryptoError]
    sequence<u8> mnemonic_to_seed(string mnemonic);

    [Throws=CryptoError]
    RecoveryKeypair derive_recovery_keypair(sequence<u8> seed);

    [Throws=CryptoError]
    sequence<u8> sign_recovery_challenge(sequence<u8> private_key, string message);

    boolean verify_recovery_signature(sequence<u8> public_key, string message, sequence<u8> signature);

    // Traffic Protection Functions
    sequence<u8> generate_dummy_message(u64 size);
    boolean is_dummy_message(sequence<u8> data);

    // Timing Functions
    u64 jittered_interval_ms(u64 base_ms, u64 jitter_ms);
    u64 random_send_delay_ms(u64 max_delay_ms);
    u64 heartbeat_interval_ms(u64 base_interval_sec);
    u64 battery_aware_jitter_ms(u64 base_ms, u64 max_jitter_ms, float battery_level);
    u64 recommended_send_delay_ms(boolean is_high_priority, float battery_level);

    // ── Post-Quantum KEM (ML-KEM-1024) ───────────────────────────────────────
    // The handshake runs ML-KEM inside the core; nothing on the platform calls it for sessions.
    // History transfer encapsulates to a peer's Kyber SPK with this, and the receiving side
    // decapsulates with `OrchestratorCore.kyber_prekey_decapsulate` (the seed never leaves the core).

    /// Encapsulate to an ML-KEM-1024 public key (1568 bytes).
    [Throws=CryptoError]
    MLKEMEncapsulation mlkem1024_encapsulate(sequence<u8> public_key);

    // ── Post-Quantum Signatures (ML-DSA-65 + Hybrid) ────────────────────────

    /// Generate an ML-DSA-65 keypair (post-quantum signature scheme, NIST FIPS 204).
    [Throws=CryptoError]
    MLDSAKeyPair mldsa65_keygen();

    /// Sign a message with an ML-DSA-65 secret key. Returns a detached signature (3309 bytes).
    [Throws=CryptoError]
    sequence<u8> mldsa65_sign(sequence<u8> secret_key, sequence<u8> message);

    /// Verify an ML-DSA-65 detached signature. Returns true if valid.
    [Throws=CryptoError]
    boolean mldsa65_verify(sequence<u8> public_key, sequence<u8> message, sequence<u8> signature);

    /// Generate a hybrid signature keypair (Ed25519 + ML-DSA-65).
    /// Both signatures must verify for the hybrid signature to be valid.
    [Throws=CryptoError]
    HybridSignatureKeyPair hybrid_signature_keygen();

    /// Sign a message with a hybrid private key (Ed25519 + ML-DSA-65).
    /// Returns a hybrid signature: [ed25519_sig (64)] [mldsa65_sig (3309)] = 3373 bytes.
    [Throws=CryptoError]
    sequence<u8> hybrid_sign(sequence<u8> private_key, sequence<u8> message);

    /// Verify a hybrid signature. Both Ed25519 and ML-DSA-65 signatures must be valid.
    [Throws=CryptoError]
    boolean hybrid_verify(sequence<u8> public_key, sequence<u8> message, sequence<u8> signature);

    /// Derive the hybrid public key from a hybrid private key.
    [Throws=CryptoError]
    sequence<u8> hybrid_public_key_from_private(sequence<u8> private_key);

    // ── Orchestration (Phase 0) ───────────────────────────────────────────────

    /// Create an OrchestratorCore from CFE binary or legacy JSON key bytes.
    /// Accepts both formats — Rust handles detection and migration internally.
    [Throws=CryptoError]
    OrchestratorCore create_orchestrator_core_from_keys(sequence<u8> keys_data, string my_user_id);

    /// Verify that a PlatformBridge implementation correctly round-trips a
    /// save → load through the platform secure store.
    /// Returns true if the loaded bytes equal the saved bytes.
    [Throws=CryptoError]
    boolean test_platform_bridge_roundtrip(PlatformBridge bridge, string key, bytes data);
};

// ============================================================================
// Orchestration — PlatformBridge (Phase 0)
// ============================================================================

/// Callback interface implemented by Swift / Kotlin.
///
/// Rust orchestration logic is I/O-free: it calls through this bridge to
/// request platform operations (Keychain, Core Data, os_log / Logcat).
/// Each method is synchronous from Rust's perspective.
callback interface PlatformBridge {
    /// Persist `data` under `key` in the platform secure store (Keychain / Keystore).
    void save_to_secure_store(string key, bytes data);

    /// Retrieve data previously saved under `key`. Returns null if absent.
    bytes? load_from_secure_store(string key);

    /// Append / upsert a JSON record in the platform data store (Core Data / Room).
    /// `table` is a logical table name; `json` is the record payload.
    void persist_record(string table, string json);

    /// Query the platform data store. Returns a JSON-encoded result or null.
    string? query_record(string table, string query_json);

    /// Emit a log entry through the platform logging system (os_log / Logcat).
    /// `level` ∈ {"debug", "info", "warn", "error"}.
    void log_event(string level, string tag, string message);
};

// ============================================================================
// Orchestration — Module Interfaces (Phases 1a, 1b, 2)
// ============================================================================

// ── AckCheckResult ────────────────────────────────────────────────────────────

/// Result of checking whether a message has already been processed.
/// Whose device an outgoing copy is for. A copy to our own device is the pair (me, me), which the
/// relay already knows; a copy to a peer's device is not, and must be sealed to that device's key.
enum DeliveryAudience {
    "Recipient",
    "OwnReplica",
};

dictionary DeliveryTarget {
    string device_id;
    DeliveryAudience audience;
};

/// What a queued message is, for the purpose of opening a receiving session.
enum ReceivingInitKind {
    /// Carries an X3DH init: this message can open a session.
    "Handshake",
    /// Already inside a ratchet. Initialising from it fails and destroys the queue behind it.
    "MidRatchet",
    /// `message_number == 0` but a PQ epoch has advanced — a re-keyed continuation, not an opener.
    "MidSessionLeftover",
};

/// The wire-visible shape of a queued message, for planning a receiving-session init.
/// No ciphertext: deciding whether a message *could* open a session must not require its body.
dictionary ReceivingInitCarrier {
    u32 message_number;
    u32 one_time_prekey_id;
    u32 kem_ciphertext_bytes;
    u32 pq_message_epoch;
    boolean is_session_reset_init;
};

/// One attempt: open carrier `carrier_index` against bundle `bundle_index`.
/// Indices into the caller's own arrays.
dictionary ReceivingInitAttempt {
    u32 carrier_index;
    u32 bundle_index;
};

/// What to do about one device when tearing down a session with a peer.
/// See orchestration::teardown_plan — the decision lives in the core because it is a plan,
/// and a plan is protocol.
enum TeardownAction {
    /// We hold a session with this device: send, then archive ours.
    "SendAndArchive",
    /// No session of ours, but the peer is demonstrably still on one — send, archive nothing.
    "SendOnly",
    /// Nothing to condemn, no evidence anyone is on a dead session — say nothing.
    "Skip",
};

dictionary TeardownDecision {
    string device_id;
    TeardownAction action;
};

/// Whether to open a session with a device right now, and as which side.
/// See orchestration::initiation_plan. `tie_break_role` settles a collision that has happened;
/// this settles whether to walk into one, and both peers must answer it compatibly.
enum InitiationDecision {
    /// Open a fresh session as INITIATOR now.
    "Initiate",
    /// One of ours is already in flight — join it. A second init derives a new root key, spends
    /// another one-time prekey, and orphans the first SESSION_RESET_INIT.
    "JoinInFlight",
    /// The peer's init is arriving and outranks ours. Take the responder side.
    "YieldToPeer",
    /// Nothing to send and no init in the air. Opening spends a prekey on a session that carries
    /// nothing and doubles the chance of colliding with the peer's next one.
    "Wait",
};

/// What the caller knows at the moment it wants a session. Every field is something only the
/// caller can see — the network, the outbox, the UI; the decision over them is made in the core.
dictionary InitiationContext {
    /// Ours and theirs in the space the session is addressed by. Anything else ranks a
    /// different pair — see tie_break_role.
    string my_device_id;
    string peer_device_id;
    /// We sent a SESSION_RESET_INIT to this device; it is neither acknowledged nor expired.
    boolean our_init_in_flight;
    /// We hold the peer's init — received, not yet completed.
    boolean peer_init_in_flight;
    /// Something is waiting to be sent to this device. Not "a warm session would be nice".
    boolean have_outbound_work;
};

enum AckCheckResult {
    /// Definitely a duplicate — found in the in-memory cache.
    "InCache",
    /// Not in cache; caller must query the persistent store before deciding.
    "NeedDbCheck",
    /// Confirmed not a duplicate (after DB check returned nothing).
    "NotProcessed",
};

/// Thread-safe ACK deduplication store.
///
/// Replaces Swift `PersistentACKStore`. The in-memory `HashSet` lives here;
/// CoreData / Room persistence is handled by the orchestrator CFE state.
interface RustAckStore {
    constructor();

    /// Returns `InCache` if the hot-path cache contains `message_id`, else `NeedDbCheck`.
    AckCheckResult is_processed(string message_id);

    /// Mark `message_id` as processed in the in-memory cache.
    void mark_processed(string message_id);

    /// Evict expired entries from the in-memory cache.
    void prune_expired();

    /// Current in-memory cache size (diagnostic).
    u64 cache_len();
};

// `HealingAttemptResult` and `interface RustHealingQueue` stood here until 2026-09-23. The
// object let the platform construct a second healing queue of its own, in the account space,
// beside the one the orchestrator keeps in the device space — and it was the platform's that
// decided. The question is `HealAttempted` now. Step 4 of
// decisions/session-is-one-state-machine.md.

// ── OrchestratorCore ──────────────────────────────────────────────────────────

// ── Typed event bus ──────────────────────────────────────────────────────────

/// Typed replacement for `IncomingEvent` JSON strings.
/// Platform creates one of these variants and passes to `handle_event()`.
[Enum]
interface CfeIncomingEvent {
    MessageReceived(string message_id, string from, bytes data, u32 msg_num, bytes kem_ct, u32 otpk_id, boolean is_control, u8 content_type);
    OutgoingMessage(string contact_id, string message_id, bytes plaintext, u8 content_type);
    OutgoingCallSignal(string contact_id, string message_id, bytes proto_bytes);
    SessionInitCompleted(string contact_id, bytes session_data);
    AckReceived(string message_id);
    KeyBundleFetched(string user_id, string bundle_json);
    NetworkReconnected();
    AppLaunched();
    TimerFired(string timer_id);
    /// Platform ACK DB lookup result — response to `CheckAckInDb` action.
    AckDbResult(string message_id, boolean is_processed);
    /// A heartbeat message was received from the peer.
    HeartbeatReceived(string contact_id, string message_id, bytes data, u32 msg_num);
    /// The platform is about to tear down the ratchet with `contact_id` and asks whether it may.
    /// Answered with `SendEndSession`, `EndSessionSuppressed` + `ScheduleTimer`, or
    /// `EndSessionNotNeeded` — from the same window the core's own teardowns use. `cause` says
    /// what this teardown knows, which decides how soon it may go and whether the peer's own
    /// teardown silences it.
    TeardownRequested(string contact_id, CfeTearDownCause cause);
    /// The peer tore down the ratchet with `contact_id` and the platform has applied it. A
    /// report, not a request: it opens the window that keeps our own teardown quiet, and returns
    /// no actions.
    PeerToreDown(string contact_id);
    /// The platform needs a session with `contact_id` and there is none — today, the INITIATOR
    /// re-init an inbound teardown raises. Answered with `OpenSession`, or `OpenDeferred` +
    /// `ScheduleTimer` while the peer's own rebuild may still be in the same flush.
    ReopenRequested(string contact_id);
    /// The platform is about to attempt one heal of `contact_id` and asks whether the budget
    /// allows it. Answered with `HealAttemptAllowed` or `HealExhausted` — never an empty list,
    /// because silence read as permission is an unbounded heal loop.
    HealAttempted(string contact_id);
    /// A SESSION_RESET_INIT has gone out to `contact_id`. A report, not a request: it starts the
    /// confirm window and arms the retry the core owns.
    SriAnnounced(string contact_id);
    /// The peer acknowledged the session we opened with `contact_id` — `session_ready`, a ping,
    /// or its own init carrier on the ratchet we announced. Ends the confirm window.
    PeerAcked(string contact_id);
    /// A SESSION_RESET_INIT arrived from `contact_id` and the platform asks whether to apply it.
    /// Answered with `ApplyResetInit` or `ResetInitSuperseded`. `init_ephemeral` is the X3DH
    /// ephemeral public key from the envelope — the init's identity; `sent_at_s` the envelope
    /// timestamp; `established_at_s` the platform's record of when the session it holds with this
    /// device was established (Unix seconds, null when there is none).
    ResetInitArrived(string contact_id, bytes init_ephemeral, u64 sent_at_s, u64? established_at_s);
};

/// Why a teardown is being asked for.
enum CfeTearDownCause {
    /// Nothing is known beyond "this ratchet will not open". The only cause the peer's own
    /// teardown silences: a blind teardown back tells it what it just told us.
    "Blind",
    /// A message arrived on a ratchet we no longer hold — proof the last teardown never landed.
    /// Buys the short retry window while the budget lasts, and is never silenced.
    "Unacknowledged",
    /// The teardown carries a reason the peer cannot work out for itself (today: the one-time
    /// pre-key we could not reproduce). Ordinary window, never silenced.
    "Explained",
};

/// Which durable slot a `SaveToSecureStore` payload belongs in.
///
/// The core names what the bytes are; the platform names where they go. This replaced a formatted
/// string key (`"session_<id>"`, `"archive_<id>"`, …) that the platform parsed back apart — a
/// naming rule for a store the core does not own, written six times across two repositories.
[Enum]
interface CfeSecureStoreSlot {
    /// Double Ratchet state for one contact. Empty payload means delete.
    Session(string contact_id);
    /// A terminated session, kept for late-arriving messages. Empty payload means delete.
    SessionArchive(string contact_id);
    /// Orchestrator coordination state.
    OrchestratorState();
};

/// Typed replacement for `Action` JSON strings.
/// Platform receives these from `handle_event()` and executes each one.
[Enum]
interface CfeAction {
    DecryptMessage(string contact_id, bytes ciphertext);
    EncryptMessage(string contact_id, bytes plaintext);
    InitSession(string contact_id, string bundle_json);
    ArchiveSession(string contact_id);
    MessageDecrypted(string contact_id, string message_id, bytes plaintext);
    SessionHealNeeded(string contact_id, string role);
    /// Heal suppressed by cooldown — platform must NOT ACK; server will re-deliver.
    HealSuppressed(string contact_id, u64 retry_after_ms);
    /// Our own SESSION_RESET_INIT to this device is unacknowledged, so neither heal nor tear
    /// down on the message that provoked this: buffer it and replay it when the wait ends.
    HeldPendingAck(string contact_id);
    ReplayHeld(string message_id);
    HeldSuperseded(string message_id);
    /// The heal budget allows this attempt; `attempt` is its 1-based index.
    HealAttemptAllowed(string contact_id, u32 attempt);
    /// The heal budget for this device is spent, or nothing is queued to spend it from — give up
    /// on the carrier and tear the ratchet down instead.
    HealExhausted(string contact_id);
    /// END_SESSION suppressed by cooldown — the core owes it and sends it in retry_after_ms.
    /// Platform must NOT ACK.
    EndSessionSuppressed(string contact_id, u64 retry_after_ms);
    /// A teardown was asked for and will not be sent, now or later — the peer tore this ratchet
    /// down itself. Nothing is owed; do NOT schedule a retry.
    EndSessionNotNeeded(string contact_id);
    /// Apply the SESSION_RESET_INIT that just arrived — archive and open the receiving side, even
    /// over an active session: the peer has ratcheted onto it.
    ApplyResetInit(string contact_id);
    /// Acknowledge the SESSION_RESET_INIT that just arrived, and do not apply it. `redelivery`:
    /// this exact init was already applied (true), or it pre-dates the session held (false).
    ResetInitSuperseded(string contact_id, boolean redelivery);
    /// Open a session with `contact_id` now, as INITIATOR, and announce it (X3DH +
    /// SESSION_RESET_INIT) — not a bare local init. Build it with `reopen_session`, which also
    /// covers a session still held: the PQXDH v2 upgrade sweep asks this for classical sessions.
    OpenSession(string contact_id);
    /// Too soon to open: the peer tore this ratchet down and its rebuild may be in the same
    /// flush. The core arms the retry itself; do NOT schedule one.
    OpenDeferred(string contact_id, u64 retry_after_ms);
    /// The quiet passed and the session is already back — nothing to open.
    OpenNotNeeded(string contact_id);
    /// Re-send the SESSION_RESET_INIT — unacknowledged for a retry interval, window not out.
    /// The core arms the next alarm; do NOT schedule one.
    ResendSri(string contact_id);
    /// The confirm window ran out. Release what was held behind the opening, both directions.
    OpeningGaveUp(string contact_id);
    /// Message queued inside the core behind an in-flight session init. Nothing lost.
    MessageQueuedPendingInit(string contact_id, u32 queued_count);
    /// Write `data` into `slot`; empty `data` is a delete sentinel where the slot says so.
    SaveToSecureStore(CfeSecureStoreSlot slot, bytes data);
    PersistAck(string message_id, u64 timestamp);
    PruneAckStore(u64 cutoff_ts);
    MarkMessageDelivered(string message_id);
    /// A message already handled (ACK cache, platform DB, or its ratchet key already used).
    /// Terminal: record it as processed and advance the stream cursor past it.
    DuplicateDropped(string message_id);
    FetchPublicKeyBundle(string user_id);
    SendEncryptedMessage(string to, bytes payload, string message_id, u8 content_type);
    SendReceipt(string message_id, string status);
    SendEndSession(string contact_id);
    NotifyNewMessage(string chat_id, string preview);
    NotifySessionCreated(string contact_id);
    NotifyError(string code, string message);
    ScheduleTimer(string timer_id, u64 delay_ms);
    CancelTimer(string timer_id);
    CallSignalDecrypted(string contact_id, string message_id, bytes proto_bytes);
    /// Platform must query its persistent ACK store for `message_id` and reply with `AckDbResult`.
    CheckAckInDb(string message_id);
    /// Broadcast to all linked devices that the session with `contact_id` was reset.
    NotifyLinkedDevicesOfSessionReset(string contact_id);
    /// Rust archived and removed the session for `contact_id`.
    /// Platform MUST: (1) store `archive_bytes` in the archive store, (2) delete the
    /// hot session Keychain/Keystore entry for `contact_id`.
    SessionTerminated(string contact_id, bytes archive_bytes);
};

/// Top-level orchestration facade.
///
/// Swift / Kotlin call `handle_event_json` with a JSON-encoded `IncomingEvent`
/// and receive a JSON-encoded `Vec<Action>`. All I/O is delegated back to the
/// platform via these `Action` values.
///
/// Replaces: CryptoManager + MessageRouter + SessionCoordinator + SessionHealingService
///           + PersistentACKStore + PQCKeyManager + SessionInitializationService.
interface OrchestratorCore {
    /// Typed event handler — accepts a typed `CfeIncomingEvent` and returns typed `CfeAction` list.
    [Throws=CryptoError]
    sequence<CfeAction> handle_event(CfeIncomingEvent event);

    /// Suite ID for the active session with `contact_id`.
    /// Returns 0 if no session exists.
    u16 get_session_suite_id(string contact_id);

    /// Typed registration bundle — replaces `export_registration_bundle_json()` parsing.
    [Throws=CryptoError]
    RegistrationBundleFields get_registration_bundle_fields();

    /// Raw Ed25519 signing secret key bytes (64 bytes).
    [Throws=CryptoError]
    bytes get_signing_key_bytes();

    /// Raw identity secret key bytes (32 bytes, X25519).
    [Throws=CryptoError]
    bytes get_identity_key_bytes();

    /// Check if a message ID is in the in-memory ACK cache.
    AckCheckResult ack_is_processed(string message_id);

    /// Mark a message as processed in the ACK cache.
    void ack_mark_processed(string message_id);


    // ── Session crypto (delegation from ClassicCryptoCore) ───────────────────

    [Throws=CryptoError]
    sequence<u8> export_private_keys();

    [Throws=CryptoError]
    sequence<u8> sign_bundle_data(sequence<u8> bundle_data_json);

    // Hybrid PQ identity signature key (Ed25519+ML-DSA-65). Centralized in core.
    [Throws=CryptoError]
    sequence<u8> ensure_hybrid_signature_key();

    sequence<u8>? hybrid_signature_public_key();

    [Throws=CryptoError]
    sequence<u8> sign_hybrid(sequence<u8> message);

    // High-level helpers to avoid duplicating message construction in every client.
    // These match the domain-separated formats used for SPK/Kyber-SPK hybrid signatures
    // and the hybrid<->classic identity binding cross-signature.

    sequence<u8> build_x3dh_sign_message(u8 suite_id, sequence<u8> public_key);

    sequence<u8> build_hybrid_identity_bind_message(sequence<u8> hybrid_public_key);

    [Throws=CryptoError]
    sequence<u8> sign_hybrid_prekey(u8 suite_id, sequence<u8> public_key);

    // For migration: import a hybrid sig private key that was previously stored outside the core CFE.
    [Throws=CryptoError]
    void import_hybrid_signature_private_key(sequence<u8> priv_bytes);

    [Throws=CryptoError]
    sequence<u8> export_session(string contact_id);

    [Throws=CryptoError]
    string import_session(string contact_id, sequence<u8> data);

    sequence<string> get_all_session_contact_ids();

    /// Which of `candidate_device_ids` a teardown goes to, and what to do with each.
    /// The caller passes the device set (it owns the account→devices translation, which this
    /// crate deliberately cannot do); the decision over the set is made here.
    sequence<TeardownDecision> plan_teardown(sequence<string> candidate_device_ids, boolean peer_on_dead_session);

    /// Every (carrier, bundle) pair worth attempting when opening a receiving session, in order.
    /// Both dimensions vary: fixing the carrier and rotating only the bundle finds the session
    /// only if the right carrier was guessed, and a wrong guess looks exactly like a broken bundle.
    sequence<ReceivingInitAttempt> plan_receiving_init(sequence<ReceivingInitCarrier> carriers, u32 bundle_count);

    boolean has_session(string contact_id);

    /// Whether the ratchet with this **device** was announced (SESSION_RESET_INIT sent) and the
    /// peer has not acknowledged it yet. The confirm gate; fold it over a peer's device set for
    /// the account-shaped question, since one message becomes a copy per device.
    boolean awaits_acknowledgement(string contact_id);

    SessionHealthReport? get_session_health(string contact_id);

    [Throws=CryptoError]
    string init_session(string contact_id, BinaryKeyBundle recipient_bundle);

    // Degraded INITIATOR init: identical to init_session but skips ONLY the SPK
    // age-staleness reject (PeerSpkStale). Signature verification, the X3DH agreement,
    // and the kyber-epoch requirement are all still enforced. Used to reach a peer who
    // has been offline too long to rotate their SPK (see stale-peer-reachability decision).
    // The caller is responsible for flagging the resulting session as "at-risk".
    [Throws=CryptoError]
    string init_session_allowing_stale(string contact_id, BinaryKeyBundle recipient_bundle);

    // The answer to CfeAction.OpenSession, with or without a session held: builds the new
    // session first and replaces the held one only if that succeeded. A refusal (PQ_REQUIRED
    // while the peer has no Kyber-1024 keys yet) leaves the held session exactly as it was.
    // Do not remove the session yourself before calling it.
    [Throws=CryptoError]
    string reopen_session(string contact_id, BinaryKeyBundle recipient_bundle);

    [Throws=CryptoError]
    SessionInitResult init_receiving_session(string contact_id, BinaryKeyBundle recipient_bundle, BinaryFirstMessage first_message);

    // RESPONDER init from the envelope's encrypted_payload as received. The core unpacks it, so
    // the PQXDH v2 flag, the Kyber prekey id, the KEM ciphertext and the suite-3 tags cannot be
    // lost in a platform copy. Prefer it to init_receiving_session.
    [Throws=CryptoError]
    SessionInitResult init_receiving_session_from_wire_payload(string contact_id, BinaryKeyBundle recipient_bundle, sequence<u8> wire_payload);

    [Throws=CryptoError]
    EncryptedMessageComponents encrypt_message(string contact_id, bytes plaintext);

    [Throws=CryptoError]
    DecryptedMessageResult decrypt_message(string contact_id, sequence<u8> ephemeral_public_key, u32 message_number, sequence<u8> content, u16 suite_id, u32 pq_message_epoch, sequence<u8> pq_ratchet_field);

    /// Batch offline decrypt — single mutex acquisition for the whole batch.
    /// Session is never archived on per-message failure.
    sequence<OfflineBatchResult> decrypt_offline_batch(sequence<OfflineBatchMessage> messages);

    boolean remove_session(string contact_id);

    /// Drop every piece of local orchestration state this core holds about `contact_id`:
    /// the ratchet, the archive and its timestamp, the prekey counter, the heal record, the PQ
    /// contribution, the init lock, the cooldown, the pending END_SESSION, the prewarm mark and
    /// the active-chat mark.
    ///
    /// `remove_session` removes the ratchet **and nothing else**, so all of the above outlive it
    /// and steer the next add for the same device — a contact the platform has already forgotten.
    /// None of them is reachable from outside this crate, which is why "the platform deleted this
    /// contact" had no expression here until now.
    ///
    /// Silent on the wire on purpose: a local deletion boundary, not a protocol reset. It archives
    /// nothing and emits no END_SESSION. A caller that wants the peer told does that first, with
    /// `plan_teardown`, and forgets afterwards.
    void forget_contact_state(string contact_id);

    u32 prekeys_available_count();

    [Throws=CryptoError]
    sequence<OtpkPair> generate_one_time_prekeys(u32 count);

    u32 one_time_prekey_count();

    [Throws=CryptoError]
    sequence<u8> export_one_time_prekeys();

    [Throws=CryptoError]
    void import_one_time_prekeys(sequence<u8> data);

    u32 prune_one_time_prekeys_below(u32 min_keep_id);

    // ── Kyber prekeys (ML-KEM-1024, PQXDH v2) ────────────────────────────────
    // The core generates, signs and holds them; the seeds never leave it. After every call
    // that changes them, persist `export_kyber_prekeys()` (as with `export_one_time_prekeys`).

    [Throws=CryptoError]
    sequence<KyberPrekeyUpload> generate_kyber_one_time_prekeys(u32 count);

    u32 kyber_one_time_prekey_count();

    /// After a replace-all upload of Kyber one-time keys; returns how many were removed.
    u32 prune_kyber_one_time_prekeys_below(u32 min_keep_id);

    /// Start a Kyber SPK rotation (with the classic SPK): the key to upload. Calling it again
    /// before commit/rollback returns the same key, so a retried upload uploads the same key.
    [Throws=CryptoError]
    KyberPrekeyUpload begin_kyber_spk_rotation();

    /// The server confirmed the upload. Returns false if nothing was pending.
    boolean commit_kyber_spk_rotation();

    /// The upload failed.
    void rollback_kyber_spk_rotation();

    /// The current Kyber SPK's upload record again, or null before the first commit.
    [Throws=CryptoError]
    KyberPrekeyUpload? current_kyber_spk_upload();

    /// Decapsulate with our Kyber prekey `key_id` (0 = current SPK). For history transfer; the
    /// handshake decapsulates inside the core.
    [Throws=CryptoError]
    sequence<u8> kyber_prekey_decapsulate(u32 key_id, sequence<u8> ciphertext);

    [Throws=CryptoError]
    sequence<u8> export_kyber_prekeys();

    [Throws=CryptoError]
    void import_kyber_prekeys(sequence<u8> data);

    void set_local_user_id(string user_id);

    [Throws=CryptoError]
    RotatedSpkBundle rotate_signed_prekey();

    /// Export the full orchestrator coordination state (ACK cache, healing queue,
    /// init locks, archive index, prekey tracker) as a CFE binary blob.
    /// Persist under CfeSecureStoreSlot::OrchestratorState.
    [Throws=CryptoError]
    sequence<u8> export_orchestrator_state();

    /// Restore the full orchestrator coordination state from a CFE blob.
    /// Call at app start before processing any messages.
    [Throws=CryptoError]
    void import_orchestrator_state(sequence<u8> data);

};

// ── ConstructPrivacyPass ──────────────────────────────────────────────────────

// ── SLIP-39 Social Recovery ───────────────────────────────────────────────────

/// Keys and metadata packed into the encrypted recovery bundle.
dictionary SrRecoveryBundle {
    bytes device_signing_key;
    bytes device_identity_key;
    string device_id;
    i64 created_at;
};

namespace construct_core {
    /// Blind a 32-byte nonce for OPRF token issuance.
    /// Returns packed 64 bytes: blinded_point[0..32] || blind_factor[32..64].
    /// blinded_point is sent to server; blind_factor is kept secret until finalize().
    [Throws=CryptoError]
    sequence<u8> pp_blind_token(sequence<u8> nonce);

    /// Finalize a blind token after server evaluation.
    /// evaluated_bytes  — 32-byte Ristretto point returned by server (Z = k * blinded)
    /// blind_factor     — the second 32 bytes from pp_blind_token output
    /// nonce            — original 32-byte nonce passed to pp_blind_token
    /// Returns 32-byte token to store in the wallet.
    [Throws=CryptoError]
    sequence<u8> pp_finalize_token(
        sequence<u8> evaluated_bytes,
        sequence<u8> blind_factor_bytes,
        sequence<u8> nonce
    );

    /// Verify the evaluated point is a valid Ristretto255 curve point.
    /// server_pubkey_bytes is reserved for future DLEQ batch proof verification.
    /// Returns false if evaluated_bytes cannot be decompressed.
    boolean pp_verify_client(
        sequence<u8> evaluated_bytes,
        sequence<u8> nonce,
        sequence<u8> server_pubkey_bytes
    );

    /// Verify a batched DLEQ proof (IssueTokensResponse.dleq_proof) against the
    /// client-pinned issuer public key K. Returns true iff the same k links
    /// K = k*G and every evaluated[i] = k*blinded[i] — closes malicious-issuer
    /// key-tagging (Phase C). blinded/evaluated are the batch of 32-byte points
    /// (blinded as sent to IssueTokens, evaluated as returned); proof is 64 bytes;
    /// issuer_public is the pinned 32-byte K. False on any malformed input.
    boolean pp_verify_dleq(
        sequence<sequence<u8>> blinded,
        sequence<sequence<u8>> evaluated,
        sequence<u8> proof,
        sequence<u8> issuer_public
    );

    /// Seal a finalized 32-byte token to the server's X25519 token-encryption
    /// key (token_encryption_key from /.well-known/construct-server) so relay
    /// operators cannot read spent tokens. Returns
    /// ephemeral_pub(32) || nonce(12) || ciphertext || tag(16).
    [Throws=CryptoError]
    sequence<u8> pp_seal_token_bytes(
        sequence<u8> token,
        sequence<u8> server_encryption_key
    );

    // ── ConstructSEALED (sealed sender, stealth-sealed-sender-v2 Phase 5) ────

    /// Seal serialized SenderCertificate bytes to the recipient's X25519
    /// identity public key (32 bytes). Returns the sealed box:
    /// ephemeral_pub(32) || nonce(12) || ciphertext || tag(16).
    /// Bit-compatible with the iOS CryptoKit implementation.
    [Throws=CryptoError]
    sequence<u8> sealed_seal_sender_cert(
        sequence<u8> cert_bytes,
        sequence<u8> recipient_identity_key
    );

    /// Open a sealed sender box with our X25519 identity private key
    /// (32 bytes). Returns the serialized SenderCertificate bytes — the caller
    /// parses the proto and then calls sealed_verify_sender_cert.
    [Throws=CryptoError]
    sequence<u8> sealed_unseal_sender_cert(
        sequence<u8> sealed_box,
        sequence<u8> our_identity_priv
    );

    // ── Device metadata (sealed device directory) ────────────────────────────

    /// Seal a device's own metadata to one of its account's devices.
    ///
    /// Same box as `sealed_seal_sender_cert` and the same implementation — two names because
    /// there are two purposes, and a name describing one is wrong on the other.
    ///
    /// The account has no shared key: every device holds its own X25519 identity pair, and
    /// linking establishes nothing between them. So metadata is sealed once per sibling and
    /// the copies stored together — a copy per device, units of them, and in exchange a
    /// revoked device stops being sealed to on the next re-seal instead of keeping the
    /// ability to read until a key is rotated.
    [Throws=CryptoError]
    sequence<u8> seal_to_device_key(
        sequence<u8> plaintext,
        sequence<u8> device_identity_key
    );

    /// Open one of those copies with this device's X25519 identity private key.
    /// A copy sealed to a sibling fails the AEAD tag, so a caller finds its own by trying
    /// each — the intended use, because the stored blob carries no recipient labels.
    [Throws=CryptoError]
    sequence<u8> open_with_device_key(
        sequence<u8> sealed_box,
        sequence<u8> our_identity_priv
    );

    /// Verify the server Ed25519 signature over a SenderCertificate's fields
    /// (variant-0 payload: user_id || domain || identity_key || device_id ||
    /// BE64(issued_at) || BE64(expires_at) — no separators).
    /// server_verifying_key is the 32-byte bundle verification key from
    /// /.well-known/construct-server. Returns false on any malformed input.
    boolean sealed_verify_sender_cert(
        string user_id,
        string domain,
        sequence<u8> identity_key,
        string device_id,
        i64 issued_at,
        i64 expires_at,
        sequence<u8> signature,
        sequence<u8> server_verifying_key
    );

    // ── Per-device copy tag ───────────────────────────────────────────────────
    //
    // Delivery is per account: the same envelope reaches every one of the
    // recipient's per-device streams. When one message produces one ciphertext
    // per target device, each device must recognise which copy is its own — and
    // the relay must not be able to. See crypto::device_copy_tag.
    //
    //   secret = HKDF-SHA256(X25519(our priv, peer pub),
    //                        salt = "ConstructSSTAG-v1", info = "")
    //   tag    = HMAC-SHA256(secret, base_message_id || 0x00 || target_device_id)
    //            [0..8], lowercase hex — 16 characters.
    //
    // Vectors: construct-protos/conformance/knst_device_copy_tag.json.

    /// The tag a copy addressed to target_device_id travels under.
    /// base_message_id carries no per-device or per-chunk suffix, so every chunk
    /// of one message shares a tag.
    [Throws=CryptoError]
    string device_copy_tag(
        string base_message_id,
        string target_device_id,
        sequence<u8> our_identity_private,
        sequence<u8> peer_identity_public
    );

    /// Whether tag was written for our_device_id by the device behind
    /// peer_identity_public. False for any unusable input: callers ask "is this
    /// copy foreign?", and an undecidable answer there must be "not foreign" —
    /// wrongly opening a copy costs failed decrypts, wrongly discarding one
    /// loses a message from the transcript, silently.
    boolean device_copy_tag_matches(
        string tag,
        string base_message_id,
        string our_device_id,
        sequence<u8> our_identity_private,
        sequence<u8> peer_identity_public
    );

    // ── SLIP-39 Social Recovery ───────────────────────────────────────────────

    /// Generate a 32-byte random vault key.
    [Throws=CryptoError]
    sequence<u8> sr_generate_vault_key();

    /// Split vault_key into share_count shares, requiring threshold to reconstruct.
    /// threshold must be <= share_count, both must be 2-10.
    /// Returns one 28-word mnemonic string per share.
    [Throws=CryptoError]
    sequence<string> sr_create_recovery_shares(sequence<u8> vault_key, u8 threshold, u8 share_count);

    /// Reconstruct vault_key from at least threshold share mnemonics.
    [Throws=CryptoError]
    sequence<u8> sr_reconstruct_vault_key(sequence<string> mnemonics);

    /// Encrypt a RecoveryBundle to bytes using vault_key.
    [Throws=CryptoError]
    sequence<u8> sr_seal_recovery_bundle(sequence<u8> vault_key, SrRecoveryBundle bundle);

    /// Decrypt bytes to RecoveryBundle using vault_key.
    [Throws=CryptoError]
    SrRecoveryBundle sr_open_recovery_bundle(sequence<u8> vault_key, sequence<u8> ciphertext);
};

// ============================================================================
// MLS Group Chat (RFC 9420) — Messaging Layer Security
// ============================================================================

/// Result of adding a member to an MLS group.
/// `commit` is broadcast to current members (SubmitCommit); `welcome` is
/// delivered to the new member (InviteToGroup).
dictionary MemberAddition {
    sequence<u8> commit;
    sequence<u8> welcome;
    u32 member_count;
};

/// Errors that can occur during MLS group operations.
[Error]
enum MlsError {
    "CryptoError",
    "EpochMismatch",
    "NotAMember",
    "SerializationError",
    "WelcomeError",
    "CommitError",
    "EncryptionError",
};

namespace construct_core {
    /// Restore an MlsStore from a CFE blob previously produced by
    /// `export_cfe()`. The device Ed25519 signer keys are passed separately —
    /// they are never part of the blob.
    [Throws=MlsError]
    MlsStore import_mls_store_cfe(
        sequence<u8> data,
        sequence<u8> signer_private_key,
        sequence<u8> signer_public_key
    );
};

/// Device-level MLS store (RFC 9420): ONE long-lived OpenMLS storage holding
/// all group states plus key-package private material. A Welcome can only be
/// decrypted by the store that generated the KeyPackage it addresses, so key
/// package generation, joining and all group operations share this object.
///
/// Persistence contract: after every mutating call, persist `export_cfe()`
/// in the platform secure store. In particular, persist BEFORE uploading a
/// generated key package — otherwise an inviter's Welcome will reference
/// private keys the device no longer holds.
interface MlsStore {
    /// A fresh store bound to the device's Ed25519 identity keypair.
    constructor(sequence<u8> signer_private_key, sequence<u8> signer_public_key);

    /// Generate a KeyPackage for publishing (PublishKeyPackage). Writes its
    /// private material into this store — persist before uploading.
    [Throws=MlsError]
    sequence<u8> generate_key_package();

    /// Create a new group with this device as the sole member.
    /// Returns the group id — the handle for every other group call.
    [Throws=MlsError]
    sequence<u8> create_group();

    /// Join a group from a Welcome message addressed to a KeyPackage
    /// generated by this store. Returns the joined group's id.
    [Throws=MlsError]
    sequence<u8> join_from_welcome(sequence<u8> welcome);

    /// Encrypt an application message to the group.
    [Throws=MlsError]
    sequence<u8> encrypt(sequence<u8> group_id, sequence<u8> plaintext);

    /// Decrypt an application message from another member.
    [Throws=MlsError]
    sequence<u8> decrypt(sequence<u8> group_id, sequence<u8> ciphertext);

    /// Add a member by their published KeyPackage. The commit is merged
    /// locally — call only when about to SubmitCommit.
    [Throws=MlsError]
    MemberAddition add_member(sequence<u8> group_id, sequence<u8> key_package);

    /// Remove a member by leaf index. Commit is merged locally.
    [Throws=MlsError]
    sequence<u8> remove_member(sequence<u8> group_id, u32 leaf_index);

    /// Propose leaving. Broadcast the returned message; another member's
    /// commit actually removes us.
    [Throws=MlsError]
    sequence<u8> leave_group(sequence<u8> group_id);

    /// Process and merge a commit produced by another member.
    [Throws=MlsError]
    void process_commit(sequence<u8> group_id, sequence<u8> commit);

    /// Current number of members in the group.
    [Throws=MlsError]
    u32 member_count(sequence<u8> group_id);

    /// Current MLS epoch. Increments on every commit.
    [Throws=MlsError]
    u64 epoch(sequence<u8> group_id);

    /// Snapshot the entire MLS storage as a CFE blob (msg_type 0x44).
    [Throws=MlsError]
    sequence<u8> export_cfe();
};
